# Template-only paths, dropped from every instance built with
# `git archive <sha> | tar -x` (see the `new-instance` skill). Nothing is
# deleted after extraction: this file is what keeps the archive clean.
# tests/test_template_archive.py verifies it.

# Shaping and devflow material for the template repo itself; never
# meaningful inside an instance.
docs/ export-ignore

# The Claude Code plugin's own source: distributed via the plugin
# marketplace/GitHub at its commit SHA, not copied into instances.
plugins/ export-ignore

# The template repo's own marketplace manifest.
.claude-plugin/ export-ignore

# The template's release version, fetched by the plugin's update check from
# GitHub: a copy inside an instance would go stale at the first release.
.version export-ignore

# devflow config for working on the template repo itself.
.devflow.yml export-ignore

# This file: export-ignore excludes itself from the archive too.
.gitattributes export-ignore

# Tests that assert on the template's own plugin/docs layout: the paths
# they reference don't exist in an archived instance.
tests/test_plugin_layout.py export-ignore
tests/test_maestro_net.py export-ignore

# This test clones the template's own .git to build the archive it
# checks: an archived instance never has that .git to clone.
tests/test_template_archive.py export-ignore

# This test also clones the template's own .git, and reads finalize.sh out
# of plugins/, both absent from an archived instance.
tests/test_finalize.py export-ignore

# This test clones the template's own .git to stand in for GitHub and runs
# the new-instance skill's command blocks out of plugins/.
tests/test_new_instance.py export-ignore

# Redirect left for instances still running the retired local maestro-sync:
# old syncs read it from the mirror; new instances never need it.
.claude/skills/maestro-sync/ export-ignore

# This test runs the plugin's hooks out of plugins/.
tests/test_satellite_hook.py export-ignore

# This test runs the plugin's maestro-listen out of plugins/.
tests/test_maestro_listen.py export-ignore

# This test runs the plugin's maestro-register-keys out of plugins/.
tests/test_maestro_register_keys.py export-ignore

# This test loads plugins/maestro/bin/maestro_versions.py directly and
# checks it against the template's own CHANGELOG.md: meaningless without
# plugins/, absent from an archived instance.
tests/test_maestro_versions.py export-ignore

# This test runs the plugin's maestro-sync out of plugins/ against temporary
# instances and mirrors: meaningless without plugins/, absent from an
# archived instance.
tests/test_maestro_sync.py export-ignore
