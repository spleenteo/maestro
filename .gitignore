# Owner data — never committed
private/
# The internal-mode vault folder (named after the project slug) is appended
# here automatically by the `setup` skill on first launch.

# Workspace artifacts are ephemeral, but keep the folder structure
workspace/handoff/*
!workspace/handoff/.gitkeep

# Python bytecode (bin/mem imports bin/mem_schema.py)
__pycache__/

# macOS
.DS_Store

# Local Claude Code files
.agents/
skills-lock.json
.claude/settings.local.json

# Design and devflow working documents: kept on the owner's disk, never published
docs/work/
docs/shaping*.md
