#!/usr/bin/env python3
"""Maestro satellite hook.

session-start   Reads the hook input on stdin. When the session's folder is
                inside a repo listed under `satellites:` in the Maestro
                registry, exports MEM_SCOPE through CLAUDE_ENV_FILE, writes a
                marker for the vault guard, and prints the satellite's role,
                the mother's identity extract and the memory rules as
                additional context. Anywhere else it prints nothing.
pre-tool-use M  Called by vault-guard with the marker M: allows Read, Write,
                Edit, Grep and Glob on paths under the satellite's vault folder.

The hook runs in every session on the machine: it never fails the session.
Any error outside a satellite is silent; inside a satellite it becomes one
line of context.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

HERE = Path(__file__).resolve().parent
PLUGIN_ROOT = HERE.parent
MIN_SCHEMA_API = 2

# Sections of the mother's preferences a satellite may see: the exact name,
# optionally followed by a parenthetical ("Identity (the orchestrator)").
IDENTITY_RE = re.compile(
    r"(identity|owner [—-] basics|communication preferences|writing register)(\s*\(.*\))?")
HEADING_RE = re.compile(r"^ {0,3}(#{1,6})(?:[ \t]+(.*?))?(?:[ \t]+#+)?[ \t]*$")
FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
UNDERLINE_RE = re.compile(r"^ {0,3}(?:-+|=+)[ \t]*$")


def registry_path() -> Path:
    env = os.environ.get("MAESTRO_INSTANCES")
    return Path(env).expanduser() if env else Path.home() / ".claude" / "maestro-instances.yaml"


def load_net():
    loader = SourceFileLoader("maestro_net", str(PLUGIN_ROOT / "bin" / "maestro-net"))
    spec = spec_from_loader("maestro_net", loader)
    module = module_from_spec(spec)
    loader.exec_module(module)
    return module


def inside(path: str, root: str) -> bool:
    return path == root or path.startswith(root.rstrip(os.sep) + os.sep)


def marker_path(project_dir: str) -> Path | None:
    """Marker for a project; the name escapes `%` and `/` like vault-guard does."""
    data = os.environ.get("CLAUDE_PLUGIN_DATA")
    if not data or not project_dir:
        return None
    return Path(data) / "satellites" / project_dir.replace("%", "%25").replace("/", "%2F")


def drop_marker(marker: Path | None) -> None:
    try:
        if marker:
            marker.unlink()
    except OSError:
        pass


def schema_api(mother: Path) -> int:
    try:
        text = (mother / "bin" / "mem_schema.py").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return 0
    m = re.search(r"^SCHEMA_API\s*=\s*(\d+)", text, re.MULTILINE)
    return int(m.group(1)) if m else 0


def satellite_row(mother: Path, scope: str) -> dict | None:
    env = {k: v for k, v in os.environ.items() if k not in ("MEM_DB", "MEM_SCOPE")}
    try:
        out = subprocess.run(
            [str(mother / "bin" / "mem"), "satellite", "show", scope, "--json"],
            capture_output=True, text=True, env=env, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    try:
        row = json.loads(out.stdout)
    except ValueError:
        return None
    return row if isinstance(row, dict) else None


def identity_extract(mother: Path) -> str:
    """Whitelisted level-2 sections of the mother's preferences, nothing else.

    Fails closed: fenced code never opens a section, and any level-1 or
    level-2 heading, setext underline or `---` rule closes the current one."""
    try:
        text = (mother / "private" / "preferences.md").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""
    if text.startswith("---"):
        end = text.find("\n---", 3)
        text = text[end + 4:] if end != -1 else ""
    lines = text.splitlines()
    kept, keep, fence = [], False, None
    for i, line in enumerate(lines):
        if fence:
            if re.match(r"^ {0,3}" + re.escape(fence[0]) + "{" + str(len(fence)) + r",}[ \t]*$", line):
                fence = None
            if keep:
                kept.append(line)
            continue
        m = FENCE_RE.match(line)
        if m:
            fence = m.group(1)
            if keep:
                kept.append(line)
            continue
        h = HEADING_RE.match(line)
        if h and len(h.group(1)) <= 2:
            name = (h.group(2) or "").strip()
            keep = len(h.group(1)) == 2 and bool(IDENTITY_RE.fullmatch(name.lower()))
            if keep:
                kept.append("### " + name)
            continue
        if UNDERLINE_RE.match(line):
            keep = False
            continue
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        if line.strip() and UNDERLINE_RE.match(nxt):
            keep = False
            continue
        if keep:
            kept.append(line)
    return "\n".join(kept).strip()


def context_text(scope: str, mother_name: str, mother: Path, row: dict, identity: str,
                 exported: bool, vault_open: bool, can_request: bool) -> str:
    mem = mother / "bin" / "mem"
    lines = [
        f"# Satellite session: {scope}",
        "",
        f"This repository is a satellite of the Maestro instance `{mother_name}` ({mother}). "
        "Speak with that instance's identity and voice; the role below adds a project mandate and "
        "method, never a persona of its own.",
        "",
        "## Role",
    ]
    for label, key in (("Project type", "project_type"), ("Mandate", "mandate"), ("Method", "method"),
                       ("Constraints", "constraints"), ("Language", "language")):
        if row.get(key):
            lines.append(f"- {label}: {row[key]}")
    if identity:
        lines += ["", "## Identity (from the mother instance)", "", identity]
    lines += [
        "",
        "## Memory",
        f"- Memory lives in the mother's db under scope `{scope}`. Run every memory command with the "
        f"scope in front: `MEM_SCOPE={scope} \"{mem}\" save …` (also task, idea, done, search, today, "
        "todo). Without the prefix the command reads and writes the mother's own memory.",
    ]
    if exported:
        lines.append(f"- `MEM_SCOPE={scope}` is also exported to this session's Bash environment.")
    else:
        lines.append("- Warning: the session environment couldn't be set, so `MEM_SCOPE` is not exported: "
                     "the prefix is the only thing keeping memory in this scope.")
    lines += [
        f"- Announce every write in one line. Full rules: `{mother / 'CLAUDE.md'}`, section `## Memory`.",
        "- Never run `bin/mem embed` or the warm task channel garbage collector: they belong to the mother.",
        f"- For a question the mother can answer about this project: `maestro-net ask {mother_name} \"…\"`. "
        "The mother answers only from this scope's memories, its row and its vault folder.",
        "- Skills of the Maestro plugin run in this session as in any other: `/maestro:listen` "
        "(live capture of a call, filed where this satellite keeps documents) and `maestro-net`.",
        f"- Prose for a human reader follows the writing register: `{mother / 'CLAUDE.md'}`, "
        "section `## Writing register`.",
    ]
    if can_request:
        lines.append(f"- For work that belongs to the mother (its skills, agents, vault documents): "
                     f"`maestro-net request \"<goal and where the result goes>\"`. The answer arrives as a "
                     f"message from the request session, or as the memory `request <name>` in this scope.")
    if row.get("vault_folder"):
        lines += [
            "",
            "## Documents",
            f"- The linked vault folder is `{row['vault_folder']}`: documents for this project go there.",
            f"- Every document passes `{mother / 'bin' / 'register-check'} <file>` before delivery.",
        ]
        if not vault_open:
            lines.append("- The plugin couldn't record this session for the vault guard: file tools on "
                         "that folder will ask for permission.")
    return "\n".join(lines)


def emit_context(text: str) -> None:
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}}))


def export_scope(scope: str) -> bool:
    env_file = os.environ.get("CLAUDE_ENV_FILE")
    if not env_file:
        return False
    try:
        with open(env_file, "a", encoding="utf-8") as f:
            f.write(f"export MEM_SCOPE={scope}\n")
    except OSError:
        return False
    return True


def write_marker(marker: Path | None, scope: str, vault: str | None) -> bool:
    if not marker:
        return False
    try:
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.write_text(json.dumps({"scope": scope, "vault": vault}), encoding="utf-8")
    except OSError:
        return False
    return True


def start_satellite(scope: str, entry: dict, registry: dict, marker: Path | None) -> None:
    mother_name = entry["mother"]
    mother_entry = registry["instances"].get(mother_name)
    if not mother_entry:
        emit_context(f"Maestro: this repo is registered as satellite `{scope}` of `{mother_name}`, "
                     "which the registry doesn't list. Satellite mode is off.")
        return
    mother = Path(mother_entry["path"]).expanduser()
    if schema_api(mother) < MIN_SCHEMA_API:
        emit_context(f"Maestro: this repo is satellite `{scope}` of `{mother_name}`, but that "
                     f"instance's bin/mem is too old for satellites (needs SCHEMA_API {MIN_SCHEMA_API}). "
                     "Satellite mode is off until the mother is updated.")
        return
    row = satellite_row(mother, scope)
    if row is None:
        emit_context(f"Maestro: this repo is satellite `{scope}` in the registry, but `{mother_name}` "
                     f"has no satellites row for it (`{mother / 'bin' / 'mem'} satellite add`). "
                     "Satellite mode is off.")
        return
    if os.path.realpath(row.get("repo_path") or "") != os.path.realpath(os.path.expanduser(entry["repo"])):
        emit_context(f"Maestro: satellite `{scope}` points to {entry['repo']} in the registry and to "
                     f"{row.get('repo_path')} in `{mother_name}`. Satellite mode is off until they agree.")
        return
    identity = identity_extract(mother)
    vault_open = write_marker(marker, scope, row.get("vault_folder"))
    exported = export_scope(scope)
    can_request = "request" in (mother_entry.get("accepts") or [])
    emit_context(context_text(scope, mother_name, mother, row, identity, exported, vault_open, can_request))


def session_start() -> int:
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = {}
    if not isinstance(data, dict):
        data = {}
    folder = data.get("cwd") or os.getcwd()
    project_dir = os.environ.get("CLAUDE_PROJECT_DIR") or folder
    marker = marker_path(project_dir)
    drop_marker(marker)

    reg_file = registry_path()
    try:
        raw = reg_file.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return 0
    if "satellites:" not in raw:
        return 0
    try:
        net = load_net()
        registry = net.parse_registry(raw, str(reg_file))
    except Exception:
        return 0
    scope, entry = net.match_satellite(registry, folder)
    if scope is None:
        return 0
    try:
        start_satellite(scope, entry, registry, marker)
    except Exception as exc:
        drop_marker(marker)
        emit_context(f"Maestro: satellite `{scope}` failed at session start "
                     f"({exc.__class__.__name__}: {exc}). Satellite mode may be incomplete.")
    return 0


def unsafe_pattern(tool_name: str, tool_input: dict) -> bool:
    """A Glob pattern or a Grep glob that can climb out of the path it's given."""
    key = {"Glob": "pattern", "Grep": "glob"}.get(tool_name)
    value = tool_input.get(key) if key else None
    return isinstance(value, str) and (".." in value or value.startswith(("/", "~")))


def pre_tool_use(marker: str) -> int:
    try:
        info = json.loads(Path(marker).read_text(encoding="utf-8"))
        data = json.load(sys.stdin)
    except (OSError, ValueError):
        return 0
    if not isinstance(info, dict) or not isinstance(data, dict):
        return 0
    vault = info.get("vault")
    tool_input = data.get("tool_input")
    if not vault or not isinstance(tool_input, dict):
        return 0
    target = tool_input.get("file_path") or tool_input.get("path")
    if not isinstance(target, str) or not target or unsafe_pattern(data.get("tool_name", ""), tool_input):
        return 0
    if inside(os.path.realpath(target), os.path.realpath(vault)):
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "allow",
            "permissionDecisionReason": "Maestro satellite: linked vault folder",
        }}))
    return 0


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        if mode == "session-start":
            return session_start()
        if mode == "pre-tool-use" and len(sys.argv) > 2:
            return pre_tool_use(sys.argv[2])
    except Exception:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
