#!/usr/bin/env python3
"""Maestro satellite hook.

session-start   Reads the hook input on stdin. When the session's folder is
                a Maestro instance root behind the template, prints one line
                saying which version is available (the update check below).
                When the folder is inside a repo listed under `satellites:`
                in the Maestro registry, exports MEM_SCOPE through
                CLAUDE_ENV_FILE, writes a marker for satellite-guard, and
                prints the satellite's role, the mother's identity extract
                and the memory rules as additional context. Anywhere else it
                prints nothing. One JSON line per run at most.
pre-tool-use M  Called by satellite-guard with the marker M: allows Read,
                Write, Edit, Grep and Glob on paths under the satellite's
                vault folder.
user-prompt-submit M
                Called by satellite-guard: counts active time and, on a short
                closing prompt ("ok", "grazie") after some work, adds one line
                asking whether the last exchange deserves a memory.
stop M          Called by satellite-guard at the end of every turn: after an
                hour of active time with no new row in the satellite's scope,
                blocks the stop once and asks for a memory.
update-fetch    The detached fetcher the update check spawns: reads the
                template's `.version` from MAESTRO_VERSION_URL (default: the
                raw GitHub file) and rewrites the update cache. Exits 0 and
                leaves the cache alone on any error.

The update check compares the cached upstream version (MAESTRO_UPDATE_CACHE
or ~/.claude/maestro-update-check.json) with where the instance stands:
`private/.version`, written by maestro-sync, or its CLAUDE.md
`maestro_version` when newer or when the stamp is missing; when the cache is missing or older than
MAESTRO_UPDATE_INTERVAL seconds (default 12 hours) it stamps `checked_at`
and spawns the fetcher, without waiting. Outside an instance root it does
nothing and spawns nothing.

The hook runs in every session on the machine: it never fails the session.
Any error outside a satellite is silent; inside a satellite it becomes one
line of context.
"""

from __future__ import annotations

import json
import os
import re
import shlex
import signal
import subprocess
import sys
import tempfile
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
PLUGIN_ROOT = HERE.parent

sys.dont_write_bytecode = True  # the plugin folder is a checkout: no __pycache__/
sys.path.insert(0, str(PLUGIN_ROOT / "bin"))
from maestro_registry import NetError, inside, is_instance_dir, parse_registry, registry_path  # noqa: E402
from maestro_satellites import MIN_SCHEMA_API, clean_env, match_satellite, schema_api  # noqa: E402
from maestro_satellites import satellite_row as mother_row  # noqa: E402
from maestro_versions import instance_version, is_newer, update_cache_path  # noqa: E402

VERSION_URL = "https://raw.githubusercontent.com/spleenteo/maestro/main/.version"
UPDATE_INTERVAL = 43200  # seconds: twice a day
UPSTREAM_RE = re.compile(r"^v\d{4}\.\d{2}\.\d{2}\.\d+\s*$")

# Sections of the mother's preferences a satellite may see: the exact name,
# optionally followed by a parenthetical ("Identity (the orchestrator)").
IDENTITY_RE = re.compile(
    r"(identity|owner [—-] basics|communication preferences|writing register)(\s*\(.*\))?")
HEADING_RE = re.compile(r"^ {0,3}(#{1,6})(?:[ \t]+(.*?))?(?:[ \t]+#+)?[ \t]*$")
FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
UNDERLINE_RE = re.compile(r"^ {0,3}(?:-+|=+)[ \t]*$")

# The nudges. Active time grows at every stop by the length of the turn (the
# model working, capped at TURN_CAP) and at every prompt by the owner's pause
# since the last stop, only when that pause is at most IDLE_CAP: a longer one
# means the session sat idle and adds nothing.
IDLE_CAP = 900          # seconds: an owner's pause longer than this counts as zero
TURN_CAP = 3 * 3600     # seconds: a turn longer than this counts as this
CLOSING_AFTER = 600     # active seconds before a closing word gets a nudge
NUDGE_AFTER = 3600      # active seconds with no new row before Stop blocks
STATE_TTL = 7 * 86400   # session state files older than this are pruned
CLOSING_WORDS = 4       # a closing prompt is a few words
CLOSING_RE = re.compile(
    r"(ok(ay)?|perfett[oaie]|perfect|grazie|thanks|thank you|funziona|it works|works|ottimo|great|"
    r"top|va bene|fatto|done|next|prossimo|avanti)\b", re.I)
SESSION_ID_RE = re.compile(r"[A-Za-z0-9_-]{1,128}")

# When to write a memory. The mother's CLAUDE.md is the source; the fallback
# covers a mother whose CLAUDE.md lacks the section.
LOG_HEADING = "### Writing to the log"
LOG_FALLBACK = (
    "Write proactively, without being asked, when you detect: completed work (a task finished, "
    "a feature shipped, a fix, a configuration) → `memory`; the owner telling you something happened "
    "(a call, a decision, a purchase) → `memory`; a closing signal (\"ok\", \"perfect\", \"thanks\", "
    "\"next topic\") → check whether the last exchange deserves a `memory`; an idea (\"we could\", "
    "\"someday\") → `idea`. In doubt, ask briefly rather than pollute the log or miss an entry.")
TYPE_EXAMPLES = {
    "development": "a merge or push to main, a deploy, an infrastructure change (DNS, domains, services), "
                   "a technical decision with its reason",
    "ux": "a design decision, a handoff delivered, a test validated",
    "consulting": "a client decision, a deliverable sent, a change of scope",
}


def marker_path(project_dir: str) -> Path | None:
    """Marker for a project; the name escapes `%` and `/` like satellite-guard does."""
    data = os.environ.get("CLAUDE_PLUGIN_DATA")
    if not data or not project_dir:
        return None
    return Path(data) / "satellites" / project_dir.replace("%", "%25").replace("/", "%2F")


def drop_marker(marker: Path | None) -> None:
    try:
        if marker:
            marker.unlink()
    except OSError:
        pass


def identity_extract(mother: Path) -> str:
    """Whitelisted level-2 sections of the mother's preferences, nothing else.

    Fails closed: fenced code never opens a section, and any level-1 or
    level-2 heading, setext underline or `---` rule closes the current one."""
    try:
        text = (mother / "private" / "preferences.md").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""
    if text.startswith("---"):
        end = text.find("\n---", 3)
        text = text[end + 4:] if end != -1 else ""
    lines = text.splitlines()
    kept, keep, fence = [], False, None
    for i, line in enumerate(lines):
        if fence:
            if re.match(r"^ {0,3}" + re.escape(fence[0]) + "{" + str(len(fence)) + r",}[ \t]*$", line):
                fence = None
            if keep:
                kept.append(line)
            continue
        m = FENCE_RE.match(line)
        if m:
            fence = m.group(1)
            if keep:
                kept.append(line)
            continue
        h = HEADING_RE.match(line)
        if h and len(h.group(1)) <= 2:
            name = (h.group(2) or "").strip()
            keep = len(h.group(1)) == 2 and bool(IDENTITY_RE.fullmatch(name.lower()))
            if keep:
                kept.append("### " + name)
            continue
        if UNDERLINE_RE.match(line):
            keep = False
            continue
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        if line.strip() and UNDERLINE_RE.match(nxt):
            keep = False
            continue
        if keep:
            kept.append(line)
    return "\n".join(kept).strip()


def log_criterion(mother: Path) -> str:
    """The first paragraph under `### Writing to the log` in the mother's CLAUDE.md, or the fallback."""
    try:
        lines = (mother / "CLAUDE.md").read_text(encoding="utf-8", errors="replace").splitlines()
        start = [line.strip() for line in lines].index(LOG_HEADING) + 1
    except (OSError, ValueError):
        return LOG_FALLBACK
    para = []
    for line in lines[start:]:
        if line.startswith("#"):
            break
        if not line.strip():
            if para:
                break
            continue
        para.append(line.strip())
    return " ".join(para) or LOG_FALLBACK


def translation_enabled(identity: str) -> bool:
    """True when the identity extract's Writing register block sets translation.enabled: true.

    Reads the indented lines under a top-level `translation:` key, fenced or
    not, and accepts `enabled: true` as its direct child only."""
    in_block, depth = False, None
    for line in identity.splitlines():
        stripped = line.strip()
        if not line.startswith((" ", "\t")) and stripped:
            in_block, depth = stripped == "translation:", None
            continue
        if not in_block or not stripped:
            continue
        indent = len(line) - len(line.lstrip(" \t"))
        if depth is None:
            depth = indent
        if indent == depth and re.fullmatch(r"enabled:\s*(true|yes|on)", stripped, re.I):
            return True
    return False


def context_text(scope: str, mother_name: str, mother: Path, row: dict, identity: str,
                 exported: bool, vault_open: bool, can_request: bool) -> str:
    mem = mother / "bin" / "mem"
    lines = [
        f"# Satellite session: {scope}",
        "",
        f"This repository is a satellite of the Maestro instance `{mother_name}` ({mother}). "
        "Speak with that instance's identity and voice; the role below adds a project mandate and "
        "method, never a persona of its own.",
        "",
        "## Role",
    ]
    for label, key in (("Project type", "project_type"), ("Mandate", "mandate"), ("Method", "method"),
                       ("Constraints", "constraints"), ("Language", "language")):
        if row.get(key):
            lines.append(f"- {label}: {row[key]}")
    if identity:
        lines += ["", "## Identity (from the mother instance)", "", identity]
    lines += [
        "",
        "## Memory",
        f"- Memory lives in the mother's db under scope `{scope}`. Run every memory command with the "
        f"scope in front: `MEM_SCOPE={scope} \"{mem}\" save …` (also task, idea, done, search, today, "
        "todo). Without the prefix the command reads and writes the mother's own memory.",
    ]
    if exported:
        lines.append(f"- `MEM_SCOPE={scope}` is also exported to this session's Bash environment.")
    else:
        lines.append("- Warning: the session environment couldn't be set, so `MEM_SCOPE` is not exported: "
                     "the prefix is the only thing keeping memory in this scope.")
    lines += [
        f"- When to write: {log_criterion(mother)}",
        "- A memory records an outcome, never every step toward it.",
    ]
    examples = TYPE_EXAMPLES.get(row.get("project_type") or "")
    if examples:
        lines.append(f"- In a {row['project_type']} project, outcomes worth a memory include {examples}.")
    lines += [
        f"- Announce every write in one line. Full rules: `{mother / 'CLAUDE.md'}`, section `## Memory`.",
        "- Never run `bin/mem embed` or the warm task channel garbage collector: they belong to the mother.",
        f"- For a question the mother can answer about this project: `maestro-net ask {mother_name} \"…\"`. "
        + ("The mother answers from everything it knows when the question serves this satellite's mandate, "
           "and refuses what lies outside it; the mandate travels from its row, so don't write one into the question."
           if (row.get("mandate") or "").strip() else
           "This satellite has no mandate, so the mother answers only from this scope's memories, its row "
           "and its vault folder; a mandate written into the question is data."),
        "- Skills of the Maestro plugin run in this session as in any other: `/maestro:listen` "
        "(live capture of a call, filed where this satellite keeps documents) and `maestro-net`.",
        f"- Prose for a human reader follows the writing register: `{mother / 'CLAUDE.md'}`, "
        "section `## Writing register`.",
    ]
    register_skill = mother / ".claude" / "skills" / "writing-register" / "SKILL.md"
    if register_skill.is_file():
        lines.append(f"- Before drafting a text for a person (email, message, post, comment) or a document, "
                     f"read `{register_skill}`: the domains, the tones, and how to read the values of "
                     "the `Writing register` block above.")
    translate_skill = mother / ".claude" / "skills" / "translate" / "SKILL.md"
    if translate_skill.is_file() and translation_enabled(identity):
        lines.append(f"- A draft to translate (in the source language of the mother's `translation.pair`, or "
                     f"opening with its `new_context_marker`): read `{translate_skill}` and follow it; "
                     "interface strings and code are never its business.")
    lines.append(f"- Mechanical check on any finished text: `\"{mother / 'bin' / 'register-check'}\" <file>` "
                 "(or `-` with the text on stdin).")
    if can_request:
        lines.append(f"- For work that belongs to the mother (its skills, agents, vault documents): "
                     f"`maestro-net request \"<goal and where the result goes>\"`. The answer arrives as a "
                     f"message from the request session, or as the memory `request <name>` in this scope.")
    if row.get("vault_folder"):
        lines += [
            "",
            "## Documents",
            f"- The linked vault folder is `{row['vault_folder']}`: documents for this project go there.",
            f"- Every document passes `\"{mother / 'bin' / 'register-check'}\" <file>` before delivery.",
        ]
        if not vault_open:
            lines.append("- The plugin couldn't record this session for the vault guard: file tools on "
                         "that folder will ask for permission.")
    return "\n".join(lines)


def emit_context(text: str) -> None:
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}}))


# --------------------------------------------------------------------------
# the update check
# --------------------------------------------------------------------------

class FetchTimeout(Exception):
    """Raised by the SIGALRM handler when the fetch outlives its alarm."""


def utc_now() -> datetime:
    return datetime.now(timezone.utc).replace(microsecond=0)


def read_update_cache(path: Path) -> dict:
    """The cache as a dict; `{}` when missing, unreadable or not an object."""
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def write_update_cache(path: Path, upstream: str | None) -> None:
    """`{"upstream", "checked_at"}` replaced atomically (mkstemp + os.replace);
    `upstream` is left out when nothing is known yet."""
    data = {"checked_at": utc_now().isoformat()}
    if upstream:
        data["upstream"] = upstream
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh)
            fh.write("\n")
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def cache_is_stale(cache: dict) -> bool:
    """True when `checked_at` is missing, unparseable or older than the
    interval (MAESTRO_UPDATE_INTERVAL seconds, default UPDATE_INTERVAL)."""
    try:
        interval = int(os.environ.get("MAESTRO_UPDATE_INTERVAL") or UPDATE_INTERVAL)
    except ValueError:
        interval = UPDATE_INTERVAL
    try:
        checked_at = datetime.fromisoformat(str(cache.get("checked_at")))
    except ValueError:
        return True
    if checked_at.tzinfo is None:
        checked_at = checked_at.replace(tzinfo=timezone.utc)
    return utc_now() - checked_at >= timedelta(seconds=interval)


def spawn_fetcher(cache_file: Path, upstream: str | None) -> None:
    """Stamp `checked_at` first, so two sessions starting together don't both
    fetch, then start `update-fetch` detached: its own session, no inherited
    stream (the hook's stdout is the JSON line Claude Code reads), no wait."""
    write_update_cache(cache_file, upstream)
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "update-fetch"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True, close_fds=True)


def update_check(folder: str) -> str | None:
    """The one-line notice when the cached upstream version is newer than the
    instance's CLAUDE.md, else None. Only in an instance root that isn't the
    template itself (`plugins/maestro/` absent). The notice comes from the
    cache as it was: a stale cache refreshes in the background, for the next
    session."""
    root = Path(folder)
    if not is_instance_dir(root) or (root / "plugins" / "maestro").is_dir():
        return None
    cache_file = update_cache_path()
    cache = read_update_cache(cache_file)
    upstream = cache.get("upstream")
    if not isinstance(upstream, str):
        upstream = None
    notice = None
    if upstream:
        try:
            local = instance_version(root)
            if is_newer(upstream, local):
                notice = (f"Maestro {upstream} is available (this instance is on {local}): "
                          "run /maestro:maestro-sync.")
        except (OSError, ValueError):  # no CLAUDE.md, or a malformed version on either side
            notice = None
    if cache_is_stale(cache):
        try:
            spawn_fetcher(cache_file, upstream)
        except OSError:
            pass
    return notice


def update_fetch() -> int:
    """Fetch the template's `.version` and rewrite the cache. Any error, a
    body that isn't a version, or a fetch past the 5-second alarm: exit 0
    with the cache untouched."""
    url = os.environ.get("MAESTRO_VERSION_URL") or VERSION_URL

    def on_alarm(_signum, _frame):
        raise FetchTimeout()

    signal.signal(signal.SIGALRM, on_alarm)
    signal.alarm(5)
    try:
        with urllib.request.urlopen(url, timeout=3) as resp:
            body = resp.read(256).decode("utf-8", errors="replace")
    except Exception:  # URLError, socket and http.client errors, FetchTimeout, a bad URL
        return 0
    finally:
        signal.alarm(0)
    if not UPSTREAM_RE.match(body):
        return 0
    try:
        write_update_cache(update_cache_path(), body.strip())
    except OSError:
        pass
    return 0


def export_scope(scope: str) -> bool:
    env_file = os.environ.get("CLAUDE_ENV_FILE")
    if not env_file:
        return False
    try:
        with open(env_file, "a", encoding="utf-8") as f:
            f.write(f"export MEM_SCOPE={shlex.quote(scope)}\n")
    except OSError:
        return False
    return True


def write_marker(marker: Path | None, scope: str, vault: str | None, mem: Path) -> bool:
    if not marker:
        return False
    try:
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.write_text(json.dumps({"scope": scope, "vault": vault, "mem": str(mem)}), encoding="utf-8")
    except OSError:
        return False
    return True


def start_satellite(scope: str, entry: dict, registry: dict, marker: Path | None,
                    session_id: str | None) -> str:
    """The satellite's context text, or the one line saying why satellite mode is off."""
    mother_name = entry["mother"]
    mother_entry = registry["instances"].get(mother_name)
    if not mother_entry:
        return (f"Maestro: this repo is registered as satellite `{scope}` of `{mother_name}`, "
                "which the registry doesn't list. Satellite mode is off.")
    mother = Path(mother_entry["path"]).expanduser()
    if schema_api(mother) < MIN_SCHEMA_API:
        return (f"Maestro: this repo is satellite `{scope}` of `{mother_name}`, but that "
                f"instance's bin/mem is too old for satellites (needs SCHEMA_API {MIN_SCHEMA_API}). "
                "Satellite mode is off until the mother is updated.")
    try:
        row = mother_row(mother_name, mother, scope, entry, timeout=10)
    except NetError as exc:
        return (f"Maestro: this repo is satellite `{scope}` of `{mother_name}`, but {exc}. "
                "Satellite mode is off.")
    identity = identity_extract(mother)
    mem = mother / "bin" / "mem"
    vault_open = write_marker(marker, scope, row.get("vault_folder"), mem)
    init_state(session_id, mem, scope)
    exported = export_scope(scope)
    can_request = "request" in (mother_entry.get("accepts") or [])
    return context_text(scope, mother_name, mother, row, identity, exported, vault_open, can_request)


def satellite_context(folder: str, marker: Path | None, session_id: str | None = None) -> str | None:
    """The satellite context for `folder`; None anywhere outside a registered satellite."""
    reg_file = registry_path()
    try:
        raw = reg_file.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None
    if "satellites:" not in raw:
        return None
    try:
        registry = parse_registry(raw, str(reg_file))
    except Exception:
        return None
    scope, entry = match_satellite(registry, folder)
    if scope is None:
        return None
    try:
        return start_satellite(scope, entry, registry, marker, session_id)
    except Exception as exc:
        drop_marker(marker)
        return (f"Maestro: satellite `{scope}` failed at session start "
                f"({exc.__class__.__name__}: {exc}). Satellite mode may be incomplete.")


def session_start() -> int:
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = {}
    if not isinstance(data, dict):
        data = {}
    folder = data.get("cwd") or os.getcwd()
    project_dir = os.environ.get("CLAUDE_PROJECT_DIR") or folder
    marker = marker_path(project_dir)
    drop_marker(marker)

    try:
        notice = update_check(folder)
    except Exception:
        notice = None
    context = satellite_context(folder, marker, data.get("session_id"))
    parts = [part for part in (notice, context) if part]
    if parts:
        emit_context("\n\n".join(parts))
    return 0


# --------------------------------------------------------------------------
# the nudges
# --------------------------------------------------------------------------

def now_seconds() -> int:
    return int(datetime.now(timezone.utc).timestamp())


def state_path(session_id) -> Path | None:
    """Per-session state; None without plugin data or a plain session id."""
    data = os.environ.get("CLAUDE_PLUGIN_DATA")
    if not data or not isinstance(session_id, str) or not SESSION_ID_RE.fullmatch(session_id):
        return None
    return Path(data) / "satellites" / "state" / f"{session_id}.json"


def read_state(path: Path) -> dict | None:
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return state if isinstance(state, dict) else None


def save_state(path: Path, state: dict) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(state), encoding="utf-8")
    except OSError:
        pass


def top_row_id(mem: str | Path, scope: str) -> int | None:
    """The highest row id in the scope (0 when empty), through bin/mem; None on any failure."""
    env = clean_env()
    env["MEM_SCOPE"] = scope
    try:
        r = subprocess.run([str(mem), "search", "--limit", "0", "--json"], capture_output=True,
                           text=True, env=env, timeout=10, stdin=subprocess.DEVNULL)
        rows = json.loads(r.stdout) if r.returncode == 0 else None
        return max((int(row["id"]) for row in rows), default=0) if isinstance(rows, list) else None
    except (OSError, subprocess.SubprocessError, ValueError, TypeError, KeyError):
        return None


def init_state(session_id, mem: Path, scope: str) -> None:
    """Create the session's state on its first start only: compaction runs
    the session start again with the same session id and must not reset the
    clock (/clear gets a new id, and a fresh count). Prunes
    stale state files of other sessions."""
    path = state_path(session_id)
    if not path:
        return
    try:
        cutoff = now_seconds() - STATE_TTL
        for old in path.parent.glob("*.json"):
            if old.stat().st_mtime < cutoff:
                old.unlink()
    except OSError:
        pass
    if path.exists():
        return
    save_state(path, {"last": now_seconds(), "active": 0, "closing_at": 0,
                      "baseline": top_row_id(mem, scope)})


def load_turn(marker: str, event: str):
    """(scope, mem, state path, state, hook input) with the active time ticked; None when anything is missing."""
    try:
        info = json.loads(Path(marker).read_text(encoding="utf-8"))
        data = json.load(sys.stdin)
    except (OSError, ValueError):
        return None
    if not isinstance(info, dict) or not isinstance(data, dict):
        return None
    scope, mem, path = info.get("scope"), info.get("mem"), state_path(data.get("session_id"))
    if not scope or not mem or not path:
        return None
    now = now_seconds()
    state = read_state(path) or {"last": now, "active": 0, "closing_at": 0, "baseline": None}
    try:
        gap = max(0, now - int(state.get("last", now)))
        if event == "stop":
            gained = min(gap, TURN_CAP)
        else:
            gained = gap if gap <= IDLE_CAP else 0
        state["active"] = int(state.get("active", 0)) + gained
    except (TypeError, ValueError):
        state["active"] = 0
    state["last"] = now
    return scope, mem, path, state, data


def reset_clock(state: dict) -> None:
    state["active"] = 0
    state["closing_at"] = 0


def user_prompt_submit(marker: str) -> int:
    turn = load_turn(marker, "prompt")
    if not turn:
        return 0
    scope, _mem, path, state, data = turn
    prompt = data.get("prompt")
    closing = (isinstance(prompt, str) and len(prompt.split()) <= CLOSING_WORDS
               and CLOSING_RE.match(prompt.strip()) is not None)
    nudge = closing and state["active"] - int(state.get("closing_at") or 0) >= CLOSING_AFTER
    if nudge:
        state["closing_at"] = state["active"]
    save_state(path, state)
    if nudge:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": (f"Maestro satellite `{scope}`: the owner's message reads as a closing "
                                  "signal after some work. Check whether the last exchange produced an "
                                  "outcome worth a memory in this scope, and save it before moving on."),
        }}))
    return 0


def stop(marker: str) -> int:
    turn = load_turn(marker, "stop")
    if not turn:
        return 0
    scope, mem, path, state, data = turn
    if data.get("stop_hook_active") or state["active"] < NUDGE_AFTER:
        save_state(path, state)
        return 0
    top = top_row_id(mem, scope)
    baseline = state.get("baseline")
    block = top is not None and isinstance(baseline, int) and top <= baseline
    if top is not None:
        state["baseline"] = top
    reset_clock(state)
    save_state(path, state)
    if block:
        print(json.dumps({"decision": "block", "reason": (
            f"Maestro satellite `{scope}`: about an hour of work and no new memory in this scope. "
            "If that work produced an outcome worth keeping (a decision, a delivery, a shipped change), "
            f"save it now with `MEM_SCOPE={scope} \"{mem}\" save …` and announce it; otherwise say in one "
            "line why nothing needs saving. Then stop.")}))
    return 0


def unsafe_pattern(tool_name: str, tool_input: dict) -> bool:
    """A Glob pattern or a Grep glob that can climb out of the path it's given."""
    key = {"Glob": "pattern", "Grep": "glob"}.get(tool_name)
    value = tool_input.get(key) if key else None
    return isinstance(value, str) and (".." in value or value.startswith(("/", "~")))


def pre_tool_use(marker: str) -> int:
    try:
        info = json.loads(Path(marker).read_text(encoding="utf-8"))
        data = json.load(sys.stdin)
    except (OSError, ValueError):
        return 0
    if not isinstance(info, dict) or not isinstance(data, dict):
        return 0
    vault = info.get("vault")
    tool_input = data.get("tool_input")
    if not vault or not isinstance(tool_input, dict):
        return 0
    target = tool_input.get("file_path") or tool_input.get("path")
    if not isinstance(target, str) or not target or unsafe_pattern(data.get("tool_name", ""), tool_input):
        return 0
    if inside(os.path.realpath(target), os.path.realpath(vault)):
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "allow",
            "permissionDecisionReason": "Maestro satellite: linked vault folder",
        }}))
    return 0


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        if mode == "session-start":
            return session_start()
        if mode == "pre-tool-use" and len(sys.argv) > 2:
            return pre_tool_use(sys.argv[2])
        if mode == "user-prompt-submit" and len(sys.argv) > 2:
            return user_prompt_submit(sys.argv[2])
        if mode == "stop" and len(sys.argv) > 2:
            return stop(sys.argv[2])
        if mode == "update-fetch":
            return update_fetch()
    except Exception:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
