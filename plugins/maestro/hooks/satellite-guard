#!/bin/sh
# Guard for the Maestro satellite hooks that fire on every tool call or turn:
# PreToolUse, UserPromptSubmit and Stop. It runs in every session on the
# machine, so it must cost nothing outside a satellite: no marker for this
# project (written by `satellite-hook session-start`) means exit at once,
# without starting Python. $1 is the satellite-hook mode.
[ -n "$1" ] && [ -n "$CLAUDE_PLUGIN_DATA" ] && [ -n "$CLAUDE_PROJECT_DIR" ] || exit 0
marker="$CLAUDE_PLUGIN_DATA/satellites/$(printf '%s' "$CLAUDE_PROJECT_DIR" | sed -e 's/%/%25/g' -e 's|/|%2F|g')"
[ -f "$marker" ] || exit 0
exec python3 "${0%/*}/satellite-hook" "$1" "$marker"
