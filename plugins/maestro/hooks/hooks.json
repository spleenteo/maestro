{
  "description": "Maestro at session start: in an instance root, one line when a newer template version is available (checked in the background twice a day); in a registered satellite repo, its scope, role and memory criterion, its linked vault folder opened to the file tools, and two nudges to write memories (a closing word after some work, an hour of work with no memory in scope).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/satellite-hook\" session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/satellite-guard\" pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/satellite-guard\" user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/satellite-guard\" stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
