from maestro_registry import is_instance_dir  # noqa: E402
from maestro_versions import (  # noqa: E402
    BASELINE_VERSION, MARKDOWN_GLOBS, changelog_top_version, parse_version, read_marker)

OK = 0
E_USAGE = 2
E_NOT_INSTANCE = 3
E_MIRROR = 4
E_PLUGIN = 5
E_STALE = 6
E_ITEM = 7
E_PARTIAL = 8
E_LOCKED = 9
POSTPONED = 10

EXIT_CODES = (
    (OK, "OK", "done"),
    (E_USAGE, "E_USAGE", "usage error, or a verb not implemented yet"),
    (E_NOT_INSTANCE, "E_NOT_INSTANCE", "not an instance root, or the template repository"),
    (E_MIRROR, "E_MIRROR", "the mirror, the working tree or a git call failed"),
    (E_PLUGIN, "E_PLUGIN", "the installed plugin can't be checked or is behind"),
    (E_STALE, "E_STALE", "the plan is older than the mirror or than a file"),
    (E_ITEM, "E_ITEM", "unknown item, or a bad plan"),
    (E_PARTIAL, "E_PARTIAL", "a write failed after others succeeded"),
    (E_LOCKED, "E_LOCKED", "another apply holds private/maestro-sync.lock"),
    (POSTPONED, "POSTPONED", "the listen unit, while a capture runs"),
)

PLUGIN_ID = "maestro@maestro"
DEFAULT_MIRROR = "~/.maestro"
MIRROR_KEY = "maestro_mirror_path"
WORKTREE_KEY = "maestro_worktree_path"
SCRIPT_PLUGIN_ROOT = Path(__file__).resolve().parent.parent
SHA_RE = re.compile(r"^[0-9a-f]{7,40}$")
NO_PLUGIN_ROOT_WARNING = (
    "no --plugin-root given: the check that the loaded plugin is the installed one is skipped")

WORKTREE_FILES_SHOWN = 10
