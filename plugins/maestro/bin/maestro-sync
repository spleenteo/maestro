LOCK_FILE = Path("private") / "maestro-sync.lock"
LOG_FILE = Path("private") / "maestro-sync.log"
DB_FILE = Path("private") / "memories.db"
MANIFEST_NAME = "manifest.json"
SET_SUFFIX = "-sync"
SET_FILES_DIR = "files"
SET_DB_PATH = "db/memories.db"
NO_VERSION = "—"

APPLY_KINDS = ("update", "new", "bin", "retired", "register")
