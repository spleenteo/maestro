MIRROR_EXCLUDED = ("docs/", "plugins/", ".claude-plugin/", "user-skills/", ".claude/skills/maestro-sync/")

# Phase 6b: paths Maestro once distributed and has since retired. A `.md`
# path is its own marker file; a folder is marked through its SKILL.md.
RETIRED_PATHS = (
    ".claude/skills/maestro-sync",
    ".claude/skills/setup",
    ".claude/skills/.disabled/setup",
    "user-skills/maestro-net",
