LISTEN_MONITOR_PATTERN = "/bin/listen-update[s]( |$)"

REGISTER_KEYS_CMD = "maestro-register-keys"
# The dotted keys `maestro-register-keys report` prints, each with the env
# var its `write` reads: a copy of that script's KEYS table. A None var is
# a key the owner never sets (synthesis is always neutral).
REGISTER_ENV: Dict[str, Optional[str]] = {
    "suspended": "MAESTRO_SUSPENDED",
    "post_pass": "MAESTRO_POST_PASS",
    "tone_default.communication": "MAESTRO_TONE_COMMUNICATION",
    "tone_default.documentation": "MAESTRO_TONE_DOCUMENTATION",
    "tone_default.synthesis": None,
    "voice": "MAESTRO_VOICE",
    "communication.sign_off": "MAESTRO_SIGN_OFF",
    "translation.enabled": "MAESTRO_TRANSLATION",
