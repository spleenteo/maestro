    "translation.new_context_marker": "MAESTRO_TRANSLATION_MARKER",
    "translation.source_words_max": "MAESTRO_TRANSLATION_WORDS_MAX",
    "translation.labels": "MAESTRO_TRANSLATION_LABELS",
    "avoid_words": "MAESTRO_AVOID_WORDS",
}
REGISTER_ENV_PREFIX = "MAESTRO_"
REGISTER_UNCHANGED = "unchanged:"
REGISTER_INVALID_EXIT = 2
NEW_PREVIEW_LINES = 30
ITEM_PREFIX = {"update": "u", "new": "n", "bin": "b", "retired": "r", "register": "g", "orphan": "o"}


class SyncError(Exception):
    """A failure with an exit code; the message goes to stderr."""

    def __init__(self, code: int, message: str):
        super().__init__(message)
        self.code = code


# --------------------------------------------------------------------------
# Subprocess helpers
# --------------------------------------------------------------------------

def git(cwd: Path, *args: str, input: Optional[str] = None) -> str:
    """One git call, its stdout. A non-zero exit, or git not runnable, is
    E_MIRROR with git's own message: nothing degrades into an empty result."""
    try:
        r = subprocess.run(["git", *args], cwd=str(cwd), capture_output=True, text=True, input=input)
    except OSError as exc:
        raise SyncError(E_MIRROR, f"cannot run git in {cwd}: {exc}")
    if r.returncode != 0:
        detail = " ".join((r.stderr.strip() or r.stdout.strip() or f"exit {r.returncode}").split())
        raise SyncError(E_MIRROR, f"git {' '.join(args)} failed in {cwd}: {detail}")
    return r.stdout


def real(path) -> Path:
    return Path(os.path.realpath(os.path.expanduser(str(path))))


def read_text(path: Path) -> str:
    """The file's text with its line endings as written (no newline translation)."""
    with open(path, encoding="utf-8", newline="") as fh:
        return fh.read()


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write_json_atomic(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# --------------------------------------------------------------------------
# Phase 0: the instance root
# --------------------------------------------------------------------------

def instance_root(path) -> Path:
    """The instance's real path. E_NOT_INSTANCE for the template repository
    (plugins/maestro/ present) or a folder without preferences.md and bin/mem."""
    root = real(path)
    if (root / "plugins" / "maestro").is_dir():
        raise SyncError(E_NOT_INSTANCE, f"{root} is the Maestro template repository, not an instance.")
    if not is_instance_dir(root):
        raise SyncError(
            E_NOT_INSTANCE,
            f"{root} is not the root of a Maestro instance (no private/preferences.md next to "
            "bin/mem). Open a session in the instance folder and run /maestro:maestro-sync there.")
    return root


# --------------------------------------------------------------------------
# Phase 1: the two paths from preferences
# --------------------------------------------------------------------------

def read_pref_key(prefs: Path, key: str) -> Optional[str]:
    """The value of `key` in preferences.md, in either shape
    (`- **key**: value` or `key: value`), first match wins, backticks and
    quotes stripped, `~` expanded. None when absent or empty."""
    pattern = re.compile(
        rf"^\s*(?:-\s*\*\*{re.escape(key)}\*\*\s*:|{re.escape(key)}\s*:)\s*(.*?)\s*$")
    try:
        text = prefs.read_text(encoding="utf-8")
    except OSError as exc:
        raise SyncError(E_NOT_INSTANCE, f"cannot read {prefs}: {exc}")
    for line in text.splitlines():
        m = pattern.match(line)
        if not m:
            continue
        value = m.group(1).strip().strip("`").strip("\"'").strip()
        if not value:
            return None
        return os.path.expanduser(value)
    return None


# --------------------------------------------------------------------------
# Phase 2: the working tree, reported as data
# --------------------------------------------------------------------------

def worktree_status(path: Optional[str]) -> dict:
    """`state` in absent | clean | uncommitted | unpushed, with the
    uncommitted `files` (porcelain lines) and the `commits` not yet pushed
    (oneline). Uncommitted edits take precedence over unpushed commits.
    Nothing is ever done to the working tree."""
    status = {"path": path, "state": "absent", "files": [], "commits": []}
    if not path:
        return status
    tree = Path(path)
    if not tree.is_dir():
        return status
    files = [ln for ln in git(tree, "status", "--porcelain").splitlines() if ln.strip()]
    try:
        log = git(tree, "log", "--oneline", "@{u}..HEAD")
    except SyncError:
        # No upstream configured: every commit no remote branch reaches is unpushed.
        log = git(tree, "log", "--oneline", "HEAD", "--not", "--remotes")
    commits = [ln for ln in log.splitlines() if ln.strip()]
    status["files"] = files
    status["commits"] = commits
    status["state"] = "uncommitted" if files else ("unpushed" if commits else "clean")
    return status


# --------------------------------------------------------------------------
# Phase 3: the mirror and the plugin
# --------------------------------------------------------------------------

def plugin_repo_url(plugin_root: Path) -> str:
    """The template's repository URL from the plugin's manifest."""
    manifest = plugin_root / ".claude-plugin" / "plugin.json"
    try:
        data = json.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise SyncError(E_PLUGIN, f"cannot read the plugin manifest {manifest}: {exc}")
    url = data.get("repository") if isinstance(data, dict) else None
    if not url or not isinstance(url, str):
        raise SyncError(E_PLUGIN, f"{manifest} declares no repository URL")
    return url


def refresh_mirror(mirror: Path, repo_url: str, instance: Path, worktree: Optional[str]) -> str:
    """Clone the mirror when missing, else refuse one with local edits or
    one that is the instance or the working tree; fetch every branch from
    the template's URL and reset to origin/main. Returns the mirror's HEAD."""
    mirror_real = real(mirror)
    others = [real(instance)] + ([real(worktree)] if worktree else [])
    if mirror_real in others:
        raise SyncError(
            E_MIRROR,
            f"The mirror path {mirror} is the instance or the working tree: refusing to reset it.")
    if (mirror / ".git").exists():
        if git(mirror, "status", "--porcelain", "--untracked-files=no").strip():
            raise SyncError(
                E_MIRROR,
                f"The mirror at {mirror} has local edits: it is not a plain mirror, "
                "refusing to reset it.")
    else:
        if mirror.exists() and not mirror.is_dir():
            raise SyncError(E_MIRROR, f"The mirror path {mirror} exists and is not a directory.")
        try:
            mirror.parent.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            raise SyncError(E_MIRROR, f"cannot create the mirror's folder {mirror.parent}: {exc}")
        git(mirror.parent, "clone", "--quiet", repo_url, str(mirror))
    git(mirror, "fetch", "--quiet", repo_url, "+refs/heads/*:refs/remotes/origin/*")
    git(mirror, "reset", "--quiet", "--hard", "origin/main")
    return git(mirror, "rev-parse", "HEAD").strip()


def installed_plugin() -> dict:
    """The user-scope maestro@maestro row of `claude plugin list --json`."""
    exe = shutil.which("claude")
    if not exe:
        raise SyncError(E_PLUGIN,
                        "The claude command isn't on PATH, so the installed plugin can't be checked.")
    try:
        r = subprocess.run([exe, "plugin", "list", "--json"], capture_output=True, text=True)
    except OSError as exc:
        raise SyncError(E_PLUGIN, f"cannot run claude: {exc}")
    if r.returncode != 0:
        detail = " ".join((r.stderr.strip() or r.stdout.strip()).split())
        raise SyncError(E_PLUGIN, f"claude plugin list --json failed (exit {r.returncode}): {detail}")
    try:
        rows = json.loads(r.stdout)
    except ValueError as exc:
        raise SyncError(E_PLUGIN, f"claude plugin list --json returned no JSON: {exc}")
    if not isinstance(rows, list):
        rows = []
    matches = [row for row in rows
               if isinstance(row, dict) and row.get("id") == PLUGIN_ID and row.get("scope") == "user"]
    return matches[0] if matches else {}


def check_plugin(mirror: Path, plugin_root: Optional[Path]) -> str:
    """The installed plugin's commit, once it is a commit of the mirror with
    origin/main among its ancestors and, when --plugin-root is given, the
    loaded plugin is the installed one. E_PLUGIN otherwise."""
    row = installed_plugin()
    version = str(row.get("version", ""))
    if not SHA_RE.fullmatch(version):
        raise SyncError(
            E_PLUGIN,
            f"{PLUGIN_ID} isn't installed at user scope from its marketplace, so its commit is unknown.")
    if plugin_root is not None:
        installed = real(row.get("installPath") or "")
        loaded = real(plugin_root)
        if installed != loaded:
            raise SyncError(
                E_PLUGIN,
                f"This session runs the Maestro plugin from {loaded}, but {installed} is installed. "
                "Restart Claude Code, then run /maestro:maestro-sync again.")
    try:
        git(mirror, "cat-file", "-e", f"{version}^{{commit}}")
        git(mirror, "merge-base", "--is-ancestor", "origin/main", version)
    except SyncError:
        raise SyncError(
            E_PLUGIN,
            f"The Maestro plugin ({version}) is behind the template's main branch. "
            "Update it, restart Claude Code, then run /maestro:maestro-sync again: "
            "`claude plugin marketplace update maestro` then `claude plugin update maestro@maestro`. "
            "If the marketplace was added from a branch, remove it and add spleenteo/maestro "
            "again without one.")
    return version


# --------------------------------------------------------------------------
# Phase 4: the instance scan
# --------------------------------------------------------------------------

def _under_retired(rel: str) -> bool:
    """Whether a relative path lies on a retired path or a listen member:
    such a file is never diffed and never lowers the version floor."""
    for retired in RETIRED_PATHS + LISTEN_MEMBERS:
        if rel == retired or rel.startswith(retired + "/"):
            return True
    return False


def _crosses_symlink(root: Path, rel: str) -> bool:
    """Whether the file or any folder on the way to it, below `root`, is a symlink."""
    current = root
    for part in Path(rel).parts:
        current = current / part
        if os.path.islink(current):
            return True
    return False


def scan_instance(root: Path) -> List[dict]:
    """The marked files of the four globs, each with its version (the
    baseline when the marker carries none): no recursion, no symlink
    following, retired paths excluded. Sorted by path."""
    found: List[dict] = []
    for pattern in MARKDOWN_GLOBS:
        for match in sorted(glob.glob(os.path.join(glob.escape(str(root)), pattern))):
            rel = os.path.relpath(match, str(root))
            if _crosses_symlink(root, rel) or not os.path.isfile(match) or _under_retired(rel):
                continue
            marked, version = read_marker(match)
            if marked:
                found.append({"path": rel, "version": version or BASELINE_VERSION})
    return sorted(found, key=lambda f: f["path"])


def version_floor(scanned: List[dict]) -> Optional[str]:
    """The lowest version across the scanned files, compared as tuples."""
    versions = []
    for entry in scanned:
        try:
            versions.append((parse_version(entry["version"]), entry["version"]))
        except ValueError:
            continue
    return min(versions)[1] if versions else None


# --------------------------------------------------------------------------
# Phase 4b: the reverse scan of the mirror
# --------------------------------------------------------------------------

def scan_mirror_new(mirror: Path, root: Path) -> List[dict]:
    """The mirror's tracked, marked `*.md` files outside the excluded
    folders whose path is absent from the instance: new upstream files."""
    pathspec = ["--", "*.md"] + [f":!:{folder}**" for folder in MIRROR_EXCLUDED]
    listed = git(mirror, "ls-files", "-z", *pathspec).split("\0")
    new: List[dict] = []
    for rel in sorted(p for p in listed if p):
        if os.path.lexists(root / rel):
            continue
        marked, version = read_marker(mirror / rel)
        if marked:
            new.append({"path": rel, "version": version or BASELINE_VERSION})
    return new


def new_file_preview(text: str) -> Tuple[str, int]:
    """The first lines of a new file plus a count of the ones left out."""
    lines = text.splitlines()
    preview = "\n".join(lines[:NEW_PREVIEW_LINES])
    rest = max(0, len(lines) - NEW_PREVIEW_LINES)
    if rest:
        preview += f"\n[... {rest} more lines]"
    return preview, len(lines)


# --------------------------------------------------------------------------
# Phase 5: the changelog slice
# --------------------------------------------------------------------------

def changelog_slice(mirror: Path, floor: Optional[str], upstream: Optional[str]) -> str:
    """The CHANGELOG entries strictly above `floor` and up to `upstream`
    included, most recent first, as text. Empty without a changelog or
    without a floor."""
    changelog = mirror / "CHANGELOG.md"
    if not changelog.is_file() or floor is None:
        return ""
    low = parse_version(floor)
    high = parse_version(upstream) if upstream else None
    entries: List[str] = []
    current: Optional[List[str]] = None
    for line in read_text(changelog).splitlines():
        m = re.match(r"^##\s+(v\d{4}\.\d{2}\.\d{2}\.\d+)\b", line)
        if m:
            version = parse_version(m.group(1))
            keep = version > low and (high is None or version <= high)
            current = [line] if keep else None
            if keep:
                entries.append("")
                entries.extend(current)
            continue
        if line.startswith("## "):
            current = None
            continue
        if current is not None:
            entries.append(line)
    return "\n".join(entries).strip("\n")


# --------------------------------------------------------------------------
# Phase 5b: bin/ drift
# --------------------------------------------------------------------------

def bin_drift(mirror: Path, root: Path) -> List[dict]:
    """Every file tracked under bin/ in the mirror that the instance lacks
    (`missing`) or holds with another checksum (`differs`)."""
    listed = git(mirror, "ls-files", "-z", "bin/").split("\0")
    drift: List[dict] = []
    for rel in sorted(p for p in listed if p):
        target = root / rel
        if not target.is_file():
            drift.append({"path": rel, "state": "missing", "checksum": None,
                          "mirror_checksum": sha256(mirror / rel)})
            continue
        own, theirs = sha256(target), sha256(mirror / rel)
        if own != theirs:
            drift.append({"path": rel, "state": "differs", "checksum": own, "mirror_checksum": theirs})
    return drift


# --------------------------------------------------------------------------
# Phase 6: diffs with the tools: exemption, locally_modified
# --------------------------------------------------------------------------

def split_frontmatter(text: str) -> Optional[Tuple[List[str], List[str], str]]:
    """(frontmatter lines, body lines, line ending) for a text opening with
    `---`, the lines kept without their endings; None without frontmatter."""
    ending = "\r\n" if "\r\n" in text else "\n"
    lines = text.split(ending)
    if not lines or lines[0].strip() != "---":
        return None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return lines[1:i], lines[i + 1:], ending
    return None


def frontmatter_groups(fm_lines: List[str]) -> List[Tuple[Optional[str], List[str]]]:
    """The frontmatter as (key, lines) groups: a top-level `key:` line opens
    a group and its indented or `- ` continuation lines follow it; lines
    before the first key form a group keyed None."""
    groups: List[Tuple[Optional[str], List[str]]] = []
    for line in fm_lines:
        m = re.match(r"^([A-Za-z_][\w.-]*)\s*:", line)
        if m:
            groups.append((m.group(1), [line]))
        elif groups:
            groups[-1][1].append(line)
        else:
            groups.append((None, [line]))
    return groups


def _tools_group(fm_lines: List[str]) -> Optional[List[str]]:
    for key, lines in frontmatter_groups(fm_lines):
        if key == "tools":
            return lines
    return None


def _with_tools(text: str, tools: Optional[List[str]]) -> str:
    """`text` with its `tools:` group replaced by `tools` (appended at the
    end of the frontmatter when absent, dropped when `tools` is None)."""
    parts = split_frontmatter(text)
    if parts is None:
        return text
    fm, body, ending = parts
    out: List[str] = []
    placed = False
    for key, lines in frontmatter_groups(fm):
        if key == "tools":
            if tools is not None and not placed:
                out.extend(tools)
                placed = True
            continue
        out.extend(lines)
    if tools is not None and not placed:
        out.extend(tools)
    return ending.join(["---"] + out + ["---"] + body)


def _frontmatter_dict(fm_lines: List[str]) -> Dict[Optional[str], List[List[str]]]:
    out: Dict[Optional[str], List[List[str]]] = {}
    for key, lines in frontmatter_groups(fm_lines):
        out.setdefault(key, []).append(lines)
    return out


def diff_with_tools_exemption(inst_text: str, mirror_text: str,
                              path: str = "") -> Tuple[Optional[str], str]:
    """(unified diff, merged text): the merged text is the mirror's with the
    instance's `tools:` group carried over; the diff is None when the two
    agree once `tools:` is set aside (frontmatter compared key by key, the
    body as is). A file without frontmatter on either side is compared whole."""
    inst_parts = split_frontmatter(inst_text)
    mirror_parts = split_frontmatter(mirror_text)
    merged = mirror_text
    if inst_parts is not None and mirror_parts is not None:
        inst_tools = _tools_group(inst_parts[0])
        if inst_tools is not None:
            merged = _with_tools(mirror_text, inst_tools)
        inst_keys = _frontmatter_dict(inst_parts[0])
        mirror_keys = _frontmatter_dict(mirror_parts[0])
        inst_keys.pop("tools", None)
        mirror_keys.pop("tools", None)
        if inst_keys == mirror_keys and inst_parts[1] == mirror_parts[1]:
            return None, merged
    if inst_text == merged:
        return None, merged
    diff = "".join(difflib.unified_diff(
        inst_text.splitlines(keepends=True), merged.splitlines(keepends=True),
        fromfile=f"instance/{path}", tofile=f"mirror/{path}"))
    return diff, merged


def last_manifest(root: Path) -> Optional[dict]:
    """The manifest of the newest backup set, by folder stamp; None without
    one, or when the newest can't be read."""
    sets = sorted((root / BACKUPS_DIR).glob("*-sync"), key=lambda p: p.name, reverse=True)
    for folder in sets:
        manifest = folder / "manifest.json"
        if not manifest.is_file():
            continue
        try:
            data = json.loads(manifest.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return None
        return data if isinstance(data, dict) else None
    return None


def locally_modified(mirror: Path, path: str, inst_text_normalised: str,
                     last_manifest: Optional[dict]) -> bool:
    """Whether the instance's text (its `tools:` already set to the mirror's
    value) matches no blob of `path` across the mirror's history. The last
    manifest's `mirror_head` is tried first; not found anywhere is True."""
    blob = git(mirror, "hash-object", "--stdin", input=inst_text_normalised).strip()
    candidates: List[str] = []
    head = (last_manifest or {}).get("mirror_head")
    if isinstance(head, str) and SHA_RE.fullmatch(head):
        candidates.append(head)
    candidates.extend(sha for sha in git(mirror, "log", "--format=%H", "--", path).split() if sha)
    if not candidates:
        return True
    queries = "\n".join(f"{sha}:{path}" for sha in candidates) + "\n"
    for line in git(mirror, "cat-file", "--batch-check", input=queries).splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[1] == "blob" and fields[0] == blob:
            return False
    return True


# --------------------------------------------------------------------------
# Phase 6b: retired paths and the listen unit
# --------------------------------------------------------------------------

def marker_file(root: Path, rel: str) -> Path:
    """The file that carries a retired path's marker: the file itself for a
    `.md` path, SKILL.md inside a folder."""
    target = root / rel
    return target / "SKILL.md" if target.is_dir() else target


def files_under(root: Path, rel: str) -> List[str]:
    target = root / rel
    if target.is_file():
        return [rel]
    found: List[str] = []
    for dirpath, _dirs, names in os.walk(target):
        for name in names:
            found.append(os.path.relpath(os.path.join(dirpath, name), str(root)))
    return sorted(found)


def _run_proc(argv: List[str]) -> Tuple[Optional[int], str]:
    """(return code, stdout) of a process check; (None, "") when the
    command isn't runnable at all."""
    try:
        r = subprocess.run(argv, capture_output=True, text=True)
    except OSError:
        return None, ""
    return r.returncode, r.stdout


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def listen_running() -> Optional[str]:
    """Why the listen unit can't go yet: a capture supervisor named by
    `~/.local/state/listen/current.json` and alive with `_supervise` on its
    command line, or an old `listen-updates` monitor found by pgrep. None
    when neither runs."""
    state = Path(os.path.expanduser("~")) / LISTEN_STATE_FILE
    if state.is_file():
        try:
            pid = int(json.loads(state.read_text(encoding="utf-8")).get("supervisor_pid") or 0)
        except (OSError, ValueError, AttributeError, TypeError):
            pid = 0
        if pid > 0 and _pid_alive(pid):
            code, out = _run_proc(["ps", "-o", "command=", "-p", str(pid)])
            if code == 0 and "_supervise" in out:
                return f"capture supervisor pid {pid}, state {state}"
    code, out = _run_proc(["pgrep", "-o", "-u", str(os.getuid()), "-f", LISTEN_MONITOR_PATTERN])
    if code == 0 and out.strip():
        return f"old listen-updates monitor pid {out.split()[0]}"
    return None


def listen_members(root: Path) -> List[dict]:
    """The existing members of the listen unit, each with its marker."""
    members: List[dict] = []
    for rel in LISTEN_MEMBERS:
        marker = marker_file(root, rel)
        if not marker.is_file():
            continue
        marked, _version = read_marker(marker)
        members.append({"path": rel, "marked": marked, "checksum": sha256(marker)})
    return members


def listen_unit(root: Path) -> Tuple[str, Optional[str], List[dict]]:
    """(state, reason, members) of the listen unit: `absent` (no marked
    member), `kept` (the skill exists without the marker: the owner's own),
    `postponed` (a capture or an old monitor runs, the reason says which) or
    `listed`. One process check per call."""
    members = listen_members(root)
    if not any(m["marked"] for m in members):
        return "absent", None, members
    if any(m["path"] == LISTEN_SKILL and not m["marked"] for m in members):
        return "kept", None, members
    reason = listen_running()
    if reason:
        return "postponed", reason, members
    return "listed", None, members


def listen_state(root: Path) -> str:
    """The listen unit's state alone. Apply calls it again at its own time:
    the plan's state is never trusted."""
    return listen_unit(root)[0]


def retired_items(root: Path) -> List[dict]:
    """The retired paths still in the instance and marked, plus the listen
    unit as one item when at least one of its members is marked."""
    items: List[dict] = []
    for rel in RETIRED_PATHS:
        marker = marker_file(root, rel)
        if not marker.is_file():
            continue
        marked, _version = read_marker(marker)
        if not marked:
            continue
        items.append({
            "kind": "retired", "path": rel, "state": "listed",
            "members": [{"path": rel, "marked": True, "checksum": sha256(marker)}],
            "files": files_under(root, rel),
        })
    state, reason, members = listen_unit(root)
    if state != "absent":
        files: List[str] = []
        for member in members:
            files.extend(files_under(root, member["path"]))
        item = {"kind": "retired", "path": LISTEN_UNIT, "state": state, "members": members,
                "files": files}
        if reason:
            item["reason"] = reason
        items.append(item)
    return items


# --------------------------------------------------------------------------
# Phase 6c: the writing register keys
# --------------------------------------------------------------------------

def register_keys_command() -> Path:
    """`maestro-register-keys` next to this script, else on PATH."""
    sibling = Path(__file__).resolve().parent / REGISTER_KEYS_CMD
    if sibling.is_file():
        return sibling
    found = shutil.which(REGISTER_KEYS_CMD)
    if found:
        return Path(found)
    raise SyncError(E_PLUGIN, f"{REGISTER_KEYS_CMD} is neither next to this command nor on PATH")


def register_item(root: Path) -> Optional[dict]:
    """One `register` item when `maestro-register-keys report` finds keys
    missing from the preferences' `## Writing register` block; None when
    the block is complete."""
    prefs = root / PREFS_FILE
    exe = register_keys_command()
    try:
        r = subprocess.run([str(exe), "report", str(prefs)], capture_output=True, text=True)
    except OSError as exc:
        raise SyncError(E_PLUGIN, f"cannot run {exe}: {exc}")
    if r.returncode != 0:
        detail = " ".join((r.stderr.strip() or r.stdout.strip()).split())
        raise SyncError(E_PLUGIN, f"{REGISTER_KEYS_CMD} report failed (exit {r.returncode}): {detail}")
    try:
        report = json.loads(r.stdout)
    except ValueError as exc:
        raise SyncError(E_PLUGIN, f"{REGISTER_KEYS_CMD} report returned no JSON: {exc}")
    missing = report.get("missing") or []
    if not missing:
        return None
    return {"kind": "register", "path": str(PREFS_FILE), "block": report.get("block"),
            "missing": missing, "hints": report.get("hints") or {}, "checksum": sha256(prefs)}


# --------------------------------------------------------------------------
# The plan
# --------------------------------------------------------------------------

def _item(kind: str, path: str, **fields) -> dict:
    """An item with the keys every kind shares, then the kind's own."""
    item: Dict[str, object] = {"id": None, "kind": kind, "path": path, "from": None, "to": None,
                               "checksum": None}
    item.update(fields)
    return item


def build_items(instance: Path, mirror: Path, upstream: Optional[str],
                warnings: List[str]) -> Tuple[List[dict], List[dict]]:
    """(scanned instance files, items) for phases 4 to 6c, ids assigned per
    kind in the order update, new, bin, retired, register, orphan."""
    scanned = scan_instance(instance)
    manifest = last_manifest(instance)
    updates: List[dict] = []
    orphans: List[dict] = []
    for entry in scanned:
        rel = entry["path"]
        inst_file, mirror_file = instance / rel, mirror / rel
        if not mirror_file.is_file():
            orphans.append(_item("orphan", rel, **{"from": entry["version"]}, checksum=sha256(inst_file)))
            continue
        inst_text, mirror_text = read_text(inst_file), read_text(mirror_file)
        diff, _merged = diff_with_tools_exemption(inst_text, mirror_text, rel)
        if diff is None:
            continue
        mirror_tools = _tools_group(split_frontmatter(mirror_text)[0]) \
            if split_frontmatter(mirror_text) else None
        normalised = _with_tools(inst_text, mirror_tools) if split_frontmatter(inst_text) else inst_text
        _marked, mirror_version = read_marker(mirror_file)
        updates.append(_item(
            "update", rel, **{"from": entry["version"]}, to=mirror_version or upstream, diff=diff,
            locally_modified=locally_modified(mirror, rel, normalised, manifest),
            checksum=sha256(inst_file)))

    news: List[dict] = []
    for entry in scan_mirror_new(mirror, instance):
        text = read_text(mirror / entry["path"])
        preview, total = new_file_preview(text)
        parts = split_frontmatter(text)
        description = None
        if parts:
            for line in parts[0]:
                m = re.match(r"^description:\s*(.*?)\s*$", line)
                if m:
                    description = m.group(1).strip().strip("\"'")
        news.append(_item("new", entry["path"], to=entry["version"], preview=preview, lines=total,
                          description=description))

    bins: List[dict] = []
    drift = bin_drift(mirror, instance)
    if drift:
        bins.append(_item("bin", "bin", files=drift))

    retired = [_item(**it) for it in retired_items(instance)]
    registers: List[dict] = []
    reg = register_item(instance)
    if reg is not None:
        registers.append(_item(**reg))

    items: List[dict] = []
    for group in (updates, news, bins, retired, registers, orphans):
        for n, item in enumerate(group, start=1):
            item["id"] = f"{ITEM_PREFIX[item['kind']]}{n}"
            items.append(item)
    return scanned, items


def build_plan(instance: Path, mirror: Path, mirror_head: str, plugin_sha: str, repo_url: str,
               tree: dict, warnings: List[str]) -> dict:
    now = datetime.now(timezone.utc).replace(microsecond=0)
    changelog_file = mirror / "CHANGELOG.md"
    upstream = changelog_top_version(changelog_file) if changelog_file.is_file() else None
    if upstream is None:
        warnings.append(f"no version heading found in {changelog_file}: the changelog slice is empty")
    scanned, items = build_items(instance, mirror, upstream, warnings)
    floor = version_floor(scanned)
    if floor is None:
        warnings.append("no marked file found in the instance: no version floor, no changelog slice")
    return {
        "created_at": now.isoformat(),
        "stamp": now.strftime("%Y%m%d-%H%M%S"),
        "instance": str(instance),
        "mirror": str(mirror),
        "mirror_head": mirror_head,
        "plugin": plugin_sha,
        "repo_url": repo_url,
        "versions": {"floor": floor, "upstream": upstream},
        "worktree": tree,
        "changelog": changelog_slice(mirror, floor, upstream),
        "warnings": warnings,
        "items": items,
    }


def item_line(item: dict) -> str:
    kind, path = item["kind"], item["path"]
    if kind == "update":
        tail = f"{item['from']} -> {item['to']}" + (" (locally modified)" if item["locally_modified"] else "")
    elif kind == "new":
        tail = f"-> {item['to']} ({item['lines']} lines)"
    elif kind == "bin":
        tail = ", ".join(f"{f['path']} {f['state']}" for f in item["files"])
    elif kind == "retired":
        tail = item["state"] + (f": {item['reason']}" if item.get("reason") else "")
        if item["state"] == "listed":
            tail += " (" + ", ".join(m["path"] + ("" if m["marked"] else " kept") for m in item["members"]) + ")"
    elif kind == "register":
        tail = f"{len(item['missing'])} keys missing, block {item['block']}"
    else:
        tail = f"{item['from']} (no longer upstream: keep, archive or delete by hand)"
    return f"{item['id']:<4} {kind:<8} {path} {tail}"


def print_summary(plan: dict, plan_file: Path) -> None:
    print(f"INSTANCE {plan['instance']}")
    print(f"MIRROR {plan['mirror']}")
    print(f"MIRROR_HEAD {plan['mirror_head']}")
    print(f"PLUGIN {plan['plugin']}")
    versions = plan["versions"]
    print(f"VERSIONS {versions['floor']} -> {versions['upstream']}")
    if plan["changelog"]:
        print("CHANGELOG")
        print(plan["changelog"])
    print(f"ITEMS {len(plan['items'])}")
    for item in plan["items"]:
        print(item_line(item))
    tree = plan["worktree"]
    print(f"WORKTREE {tree['state']}" + (f" {tree['path']}" if tree["path"] else ""))
    for line in tree["files"][:WORKTREE_FILES_SHOWN]:
        print(f"  {line}")
    for line in tree["commits"][:WORKTREE_COMMITS_SHOWN]:
        print(f"  {line}")
    for warning in plan["warnings"]:
        print(f"WARNING {warning}")
    print(f"PLAN {plan_file}")


def cmd_plan(args) -> int:
    instance = instance_root(args.instance or os.getcwd())
    prefs = instance / PREFS_FILE
    mirror = Path(read_pref_key(prefs, MIRROR_KEY) or os.path.expanduser(DEFAULT_MIRROR))
    worktree = read_pref_key(prefs, WORKTREE_KEY)
    tree = worktree_status(worktree)

    plugin_root = Path(args.plugin_root) if args.plugin_root else None
    warnings: List[str] = []
    if plugin_root is None:
        warnings.append(NO_PLUGIN_ROOT_WARNING)
        print(f"maestro-sync: warning: {NO_PLUGIN_ROOT_WARNING}", file=sys.stderr)
    repo_url = plugin_repo_url(plugin_root or SCRIPT_PLUGIN_ROOT)
    mirror_head = refresh_mirror(mirror, repo_url, instance, worktree)
    plugin_sha = check_plugin(mirror, plugin_root)

    plan = build_plan(instance, mirror, mirror_head, plugin_sha, repo_url, tree, warnings)
    plan_file = instance / PLAN_FILE
    try:
        write_json_atomic(plan_file, plan)
    except OSError as exc:
        raise SyncError(E_NOT_INSTANCE, f"cannot write the plan {plan_file}: {exc}")
    if args.json:
        print(json.dumps(plan, indent=2, ensure_ascii=False))
    else:
        print_summary(plan, plan_file)
    return OK


# --------------------------------------------------------------------------
# apply: the plan on disk, the lock, the log
# --------------------------------------------------------------------------

def utc_now() -> datetime:
    return datetime.now(timezone.utc).replace(microsecond=0)


def log_stamp(now: Optional[datetime] = None) -> str:
    """`2026-04-30T18:42:13Z`, the timestamp of every log line."""
    return (now or utc_now()).strftime("%Y-%m-%dT%H:%M:%SZ")


def append_log(root: Path, line: str) -> None:
    path = root / LOG_FILE
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(line + "\n")
    except OSError as exc:
        raise SyncError(E_NOT_INSTANCE, f"cannot append to {path}: {exc}")


def item_log_line(item: dict, marker: str, upstream: Optional[str]) -> str:
    """`<ISO>Z  <from> → <to>  <path> (<marker>)`, an em dash standing for a
    version the item has none of (a new file has no `from`; a retired path
    or the register keys take the plan's upstream as `to`)."""
    frm = item.get("from") or NO_VERSION
    to = item.get("to") or upstream or NO_VERSION
    return f"{log_stamp()}  {frm} → {to}  {item['path']} ({marker})"


def load_plan(root: Path) -> dict:
    """The plan file of `root`, checked for its shape and its instance.
    E_ITEM when missing, unreadable or made for another instance."""
    plan_file = root / PLAN_FILE
    try:
        data = json.loads(plan_file.read_text(encoding="utf-8"))
    except OSError as exc:
        raise SyncError(E_ITEM, f"no plan to apply ({exc}): run `maestro-sync plan` first")
    except ValueError as exc:
        raise SyncError(E_ITEM, f"bad plan {plan_file}: {exc}")
    keys = ("stamp", "mirror", "mirror_head", "versions", "items")
    if not isinstance(data, dict) or any(k not in data for k in keys) or not isinstance(data["items"], list):
        raise SyncError(E_ITEM, f"bad plan {plan_file}: expected the keys {', '.join(keys)}")
    if data.get("instance") != str(root):
        raise SyncError(E_ITEM, f"the plan {plan_file} was made for {data.get('instance')}, not for {root}")
    return data


def plan_item(plan: dict, item_id: str) -> dict:
    for item in plan["items"]:
        if item.get("id") == item_id:
            return item
    known = ", ".join(str(it.get("id")) for it in plan["items"]) or "none"
    raise SyncError(E_ITEM, f"unknown item {item_id}: the plan holds {known}")


def acquire_lock(root: Path) -> Path:
    """private/maestro-sync.lock, created with O_CREAT | O_EXCL so two applies
    never run at once. The caller removes it in a `finally`."""
    lock = root / LOCK_FILE
    try:
        fd = os.open(str(lock), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    except FileExistsError:
        raise SyncError(E_LOCKED, f"another apply holds {lock}: wait for it to finish, or remove "
                                  "the file if no maestro-sync is running")
    except OSError as exc:
        raise SyncError(E_NOT_INSTANCE, f"cannot create {lock}: {exc}")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(f"{os.getpid()}\n")
    return lock


def release_lock(lock: Path) -> None:
    try:
        os.unlink(lock)
    except OSError:
        pass


# --------------------------------------------------------------------------
# apply: the backup set
# --------------------------------------------------------------------------

def set_dir_for(root: Path, plan: dict) -> Path:
    return root / BACKUPS_DIR / f"{plan['stamp']}{SET_SUFFIX}"


def write_manifest(set_dir: Path, manifest: dict, code: int = E_NOT_INSTANCE) -> None:
    """The manifest, replaced atomically (tempfile + os.replace)."""
    try:
        write_json_atomic(set_dir / MANIFEST_NAME, manifest)
    except OSError as exc:
        raise SyncError(code, f"cannot write {set_dir / MANIFEST_NAME}: {exc}")


def backup_db(src: Path, dest: Path) -> None:
    """The memory db copied through sqlite3's online backup, then switched
    to journal_mode=DELETE and checked: integrity_check ok, the same
    page_count as the source, a non-empty file."""
    try:
        dest.parent.mkdir(parents=True, exist_ok=True)
        source = sqlite3.connect(str(src))
        try:
            copy = sqlite3.connect(str(dest))
            try:
                source.backup(copy)
                copy.execute("PRAGMA journal_mode=DELETE").fetchone()
                verdict = copy.execute("PRAGMA integrity_check").fetchone()[0]
                pages = (source.execute("PRAGMA page_count").fetchone()[0],
                         copy.execute("PRAGMA page_count").fetchone()[0])
            finally:
                copy.close()
        finally:
            source.close()
        size = dest.stat().st_size
    except (sqlite3.Error, OSError) as exc:
        raise SyncError(E_NOT_INSTANCE, f"cannot back up {src} to {dest}: {exc}")
    if verdict != "ok" or pages[0] != pages[1] or size == 0:
        raise SyncError(E_NOT_INSTANCE,
                        f"the backup {dest} failed its check (integrity {verdict}, pages "
                        f"{pages[0]} vs {pages[1]}, {size} bytes): nothing applied")


def manifest_entry(item: dict) -> dict:
    return {"id": item["id"], "kind": item["kind"], "path": item["path"], "from": item.get("from"),
            "to": item.get("to"), "outcome": "pending", "backups": [], "from_file": None}


def open_set(root: Path, plan: dict, selected: List[dict]) -> Tuple[Path, dict]:
    """The backup set of this plan, created on the first apply and reused
    by the next ones: the manifest is written first, every selected item
    `pending`, then the db is copied once per set. Returns (set dir, manifest)."""
    set_dir = set_dir_for(root, plan)
    manifest_file = set_dir / MANIFEST_NAME
    fresh = not manifest_file.is_file()
    if fresh:
        has_db = (root / DB_FILE).is_file()
        manifest: Dict[str, object] = {
            "stamp": plan["stamp"], "instance": str(root),
            "from": plan["versions"].get("floor"), "to": plan["versions"].get("upstream"),
            "mirror_head": plan["mirror_head"], "created_at": utc_now().isoformat(),
            "db": SET_DB_PATH if has_db else None, "items": [],
        }
    else:
        try:
            manifest = json.loads(manifest_file.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            raise SyncError(E_ITEM, f"bad manifest {manifest_file}: {exc}")
        if not isinstance(manifest, dict) or not isinstance(manifest.get("items"), list):
            raise SyncError(E_ITEM, f"bad manifest {manifest_file}: no items list")
    entries: List[dict] = manifest["items"]  # type: ignore[assignment]
    by_id = {entry.get("id"): i for i, entry in enumerate(entries)}
    for item in selected:
        entry = manifest_entry(item)
        if item["id"] in by_id:
            entries[by_id[item["id"]]] = entry
        else:
            entries.append(entry)
    try:
        set_dir.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        raise SyncError(E_NOT_INSTANCE, f"cannot create the backup set {set_dir}: {exc}")
    write_manifest(set_dir, manifest)
    if fresh and manifest["db"]:
        dest = set_dir / SET_DB_PATH
        try:
            backup_db(root / DB_FILE, dest)
        except SyncError:
            try:
                dest.unlink()
            except OSError:
                pass
            manifest["db"] = None
            write_manifest(set_dir, manifest)
            raise
    return set_dir, manifest


def back_up_file(root: Path, set_dir: Path, rel: str) -> None:
    """A copy of the instance file at files/<rel> inside the set."""
    dest = set_dir / SET_FILES_DIR / rel
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(root / rel, dest)


# --------------------------------------------------------------------------
# apply: the items
# --------------------------------------------------------------------------

def _safe_rel(root: Path, rel: object) -> bool:
    """A relative path this command may touch at all: non-empty, not `.`,
    not absolute, no `..`, not under private/, and its real path inside the
    instance."""
    if not isinstance(rel, str) or rel in ("", ".") or os.path.isabs(rel):
        return False
    parts = Path(rel).parts
    if not parts or ".." in parts or parts[0] == "private":
        return False
    target = real(root / rel)
    return target != root and str(target).startswith(str(root) + os.sep)


def check_retired_allowlist(root: Path, item: dict) -> None:
    """Defence in depth on a retired item, whatever the plan file says: the
    unit is a retired path or `listen`, every member to remove is that path
    or one of the four listen members, and no path escapes the instance.
    E_ITEM otherwise."""
    unit = item.get("path")
    if unit == LISTEN_UNIT:
        allowed = LISTEN_MEMBERS
    elif unit in RETIRED_PATHS:
        allowed = (unit,)
    else:
        raise SyncError(E_ITEM, f"refusing to remove {unit!r} ({item.get('id')}): not a retired path")
    members = item.get("members")
    if not isinstance(members, list) or not members:
        raise SyncError(E_ITEM, f"refusing {item.get('id')} {unit}: the plan names no member")
    for member in members:
        rel = member.get("path") if isinstance(member, dict) else None
        if rel not in allowed or not _safe_rel(root, rel):
            raise SyncError(E_ITEM, f"refusing to remove {rel!r} ({item.get('id')} {unit}): not a retired path")


def check_bin_paths(root: Path, item: dict) -> None:
    """Every file of a bin item lies under bin/ and inside the instance."""
    for entry in item.get("files") or []:
        rel = entry.get("path") if isinstance(entry, dict) else None
        if not isinstance(rel, str) or Path(rel).parts[:1] != ("bin",) or not _safe_rel(root, rel):
            raise SyncError(E_ITEM, f"refusing to copy {rel!r} ({item.get('id')}): not a bin/ script")


def select_items(root: Path, plan: dict, ids: Optional[List[str]], kind: Optional[str]) -> List[dict]:
    """The items to apply: those named by id (each checked against the plan)
    or every item of a kind, minus, for --kind update, the locally modified
    ones, listed on stderr. E_ITEM for an orphan, a kept retired item, an
    unknown kind, or a retired or bin item naming a path outside its
    allowlist."""
    if ids:
        candidates = []
        for item_id in ids:
            item = plan_item(plan, item_id)
            if item not in candidates:
                candidates.append(item)
    else:
        candidates = [it for it in plan["items"] if it.get("kind") == kind]
    selected: List[dict] = []
    for item in candidates:
        if item["kind"] == "orphan":
            raise SyncError(E_ITEM, f"{item['id']} {item['path']} is an orphan: reported, never applied")
        if item["kind"] not in APPLY_KINDS:
            raise SyncError(E_ITEM, f"unknown kind {item['kind']!r} ({item['id']} {item['path']}): bad plan")
        if item["kind"] == "retired":
            if item.get("state") == "kept":
                raise SyncError(E_ITEM, f"{item['id']} {item['path']} is kept: its skill carries no marker, "
                                        "so nothing of it is removed")
            check_retired_allowlist(root, item)
        if item["kind"] == "bin":
            check_bin_paths(root, item)
        if kind == "update" and item.get("locally_modified"):
            print(f"skipped (locally modified): {item['path']}", file=sys.stderr)
            continue
        selected.append(item)
    return selected


def _stale(path: str, what: str = "changed") -> SyncError:
    return SyncError(E_STALE, f"{path} {what} since the plan: run `maestro-sync plan` again")


def check_fresh(root: Path, plan: dict, selected: List[dict]) -> None:
    """E_STALE when the mirror's HEAD is no longer the plan's, or a selected
    file changed since the plan: an update's or the preferences' checksum,
    a new file's path now existing, a bin script's checksum (a missing one
    now present), a retired member's marker file."""
    mirror = Path(plan["mirror"])
    head = git(mirror, "rev-parse", "HEAD").strip()
    if head != plan["mirror_head"]:
        raise SyncError(E_STALE, f"the mirror {mirror} is at {head[:12]}, the plan was made at "
                                 f"{str(plan['mirror_head'])[:12]}: run `maestro-sync plan` again")
    for item in selected:
        kind = item["kind"]
        if kind == "new":
            if os.path.lexists(root / item["path"]):
                raise _stale(item["path"], "appeared")
        elif kind == "bin":
            for entry in item["files"]:
                target = root / entry["path"]
                if entry.get("state") == "missing":
                    if os.path.lexists(target):
                        raise _stale(entry["path"], "appeared")
                elif not target.is_file() or sha256(target) != entry.get("checksum"):
                    raise _stale(entry["path"])
        elif kind == "retired":
            for member in item["members"]:
                if not member.get("marked"):
                    continue
                marker = marker_file(root, member["path"])
                if not marker.is_file() or sha256(marker) != member.get("checksum"):
                    raise _stale(member["path"])
        else:
            target = root / item["path"]
            if not target.is_file() or sha256(target) != item.get("checksum"):
                raise _stale(item["path"])


def apply_update(root: Path, mirror: Path, item: dict, from_bytes: Optional[bytes]) -> None:
    """The mirror text with the instance's tools: carried over, or the
    --from text as given, written over the instance file."""
    target = root / item["path"]
    if from_bytes is None:
        _diff, merged = diff_with_tools_exemption(read_text(target), read_text(mirror / item["path"]),
                                                  item["path"])
        from_bytes = merged.encode("utf-8")
    with open(target, "wb") as fh:
        fh.write(from_bytes)


def apply_new(root: Path, mirror: Path, item: dict) -> None:
    target = root / item["path"]
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(mirror / item["path"], target)


def _proc_detail(r: subprocess.CompletedProcess) -> str:
    return " ".join((r.stderr.strip() or r.stdout.strip() or f"exit {r.returncode}").split())


def apply_bin(root: Path, mirror: Path, set_dir: Path, manifest: dict, item: dict, entry: dict) -> None:
    """The drifted scripts copied from the mirror with shutil.copy2 (mode
    kept), each replaced one first copied into files/bin/<name>; then
    bin/mem stats with MEM_DB and MEM_SCOPE unset, so a schema migration the
    new bin/mem carries runs while the db copy is minutes old. A failing
    stats is E_PARTIAL naming the set."""
    replaced: List[str] = []
    for entry_file in item["files"]:
        rel = entry_file["path"]
        if (root / rel).is_file():
            back_up_file(root, set_dir, rel)
            replaced.append(rel)
    entry["backups"] = replaced
    write_manifest(set_dir, manifest, E_PARTIAL)
    for entry_file in item["files"]:
        rel = entry_file["path"]
        (root / rel).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(mirror / rel, root / rel)
    env = {k: v for k, v in os.environ.items() if k not in MEM_ENV_SCRUBBED}
    mem = root / "bin" / "mem"
    try:
        r = subprocess.run([str(mem), "stats"], capture_output=True, text=True, env=env, cwd=str(root))
    except OSError as exc:
        raise SyncError(E_PARTIAL, f"cannot run bin/mem stats after the copy: {exc}; the old scripts and "
                                   f"the db copy are in {set_dir}")
    if r.returncode != 0:
        raise SyncError(E_PARTIAL, f"bin/mem stats failed after the copy (exit {r.returncode}): "
                                   f"{_proc_detail(r)}; the old scripts and the db copy are in {set_dir}")


def apply_retired(root: Path, set_dir: Path, manifest: dict, item: dict, entry: dict) -> Optional[str]:
    """The marked members of a retired item removed, each copied into
    files/<path> first; an empty user-skills/ folder removed after
    maestro-net. The listen unit's state is read again here, never from the
    plan: when a capture or an old monitor runs, nothing is touched and the
    reason is returned (the item is postponed)."""
    if item["path"] == LISTEN_UNIT:
        state, reason, _members = listen_unit(root)
        if state == "postponed":
            return reason or "a capture runs"
        if state != "listed":
            raise SyncError(E_ITEM, f"the listen unit is {state} now, not listed: run `maestro-sync plan` again")
    marked = [m["path"] for m in item["members"] if m.get("marked")]
    backups: List[str] = []
    for rel in marked:
        for file_rel in files_under(root, rel):
            back_up_file(root, set_dir, file_rel)
            backups.append(file_rel)
    entry["backups"] = backups
    write_manifest(set_dir, manifest, E_PARTIAL)
    for rel in marked:
        target = root / rel
        if target.is_dir() and not os.path.islink(target):
            shutil.rmtree(target)
        else:
            target.unlink()
    if item["path"] == "user-skills/maestro-net":
        try:
            os.rmdir(root / "user-skills")
        except OSError:
            pass
    return None


def parse_register_answers(pairs: List[str]) -> Dict[str, str]:
    """The --register KEY=VALUE answers as the env vars maestro-register-keys
    write reads. E_USAGE for a pair without `=`, an unknown key, or
    tone_default.synthesis (always neutral, never set)."""
    env: Dict[str, str] = {}
    known = ", ".join(key for key, var in REGISTER_ENV.items() if var)
    for pair in pairs:
        key, sep, value = pair.partition("=")
        key = key.strip()
        if not sep or not key:
            raise SyncError(E_USAGE, f"--register takes KEY=VALUE, got {pair!r}")
        if key not in REGISTER_ENV:
            raise SyncError(E_USAGE, f"--register: unknown key {key!r}; the keys are {known}")
        var = REGISTER_ENV[key]
        if var is None:
            raise SyncError(E_USAGE, f"--register: {key} is always neutral and is never set")
        env[var] = value
    return env


def register_env(answers: Dict[str, str]) -> Dict[str, str]:
    """This process's environment without any inherited MAESTRO_* variable,
    plus the answers: only what the owner said reaches the preferences."""
    env = {k: v for k, v in os.environ.items() if not k.startswith(REGISTER_ENV_PREFIX)}
    env.update(answers)
    return env


def validate_register_answers(answers: Dict[str, str]) -> None:
    """`maestro-register-keys render` with the answers, before any set is
    opened: its exit 2 is an invalid value, E_USAGE here with nothing
    written anywhere."""
    exe = register_keys_command()
    try:
        r = subprocess.run([str(exe), "render"], capture_output=True, text=True, env=register_env(answers))
    except OSError as exc:
        raise SyncError(E_PLUGIN, f"cannot run {exe}: {exc}")
    if r.returncode == REGISTER_INVALID_EXIT:
        raise SyncError(E_USAGE, f"--register: {_proc_detail(r)}")
    if r.returncode != 0:
        raise SyncError(E_PLUGIN, f"{REGISTER_KEYS_CMD} render failed (exit {r.returncode}): {_proc_detail(r)}")


def apply_register(root: Path, set_dir: Path, item: dict, entry: dict, answers: Dict[str, str]) -> str:
    """`maestro-register-keys write` on the preferences with the answers in
    its environment; its `backup <path>` file moved into the set as
    files/private/preferences.md and recorded as the replaced file. Returns
    the log marker: `register, N keys added, backup <set file>`, or
    `register, 0 keys added` when write found every key present."""
    exe = register_keys_command()
    prefs = root / PREFS_FILE
    try:
        r = subprocess.run([str(exe), "write", str(prefs)], capture_output=True, text=True,
                           env=register_env(answers), cwd=str(root))
    except OSError as exc:
        raise SyncError(E_PARTIAL, f"cannot run {exe}: {exc}")
    if r.returncode == REGISTER_INVALID_EXIT:
        raise SyncError(E_USAGE, f"{REGISTER_KEYS_CMD} write refused a value, nothing written: {_proc_detail(r)}")
    if r.returncode != 0:
        raise SyncError(E_PARTIAL, f"{REGISTER_KEYS_CMD} write failed (exit {r.returncode}): {_proc_detail(r)}")
    lines = r.stdout.splitlines()
    if lines and lines[0].startswith(REGISTER_UNCHANGED):
        entry["backups"] = []
        entry["keys_added"] = 0
        return "register, 0 keys added"
    backup = next((ln[len("backup "):] for ln in lines if ln.startswith("backup ")), None)
    written = next((re.match(r"^written (\d+) key", ln) for ln in lines if ln.startswith("written ")), None)
    if backup is None or written is None:
        raise SyncError(E_PARTIAL, f"{REGISTER_KEYS_CMD} write printed neither its backup nor its count: "
                                   f"{' | '.join(lines) or 'no output'}")
    dest = set_dir / SET_FILES_DIR / PREFS_FILE
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(backup, str(dest))
    added = int(written.group(1))
    entry["backups"] = [str(PREFS_FILE)]
    entry["keys_added"] = added
    return f"register, {added} keys added, backup {dest}"


def apply_item(root: Path, mirror: Path, set_dir: Path, manifest: dict, item: dict, entry: dict,
               from_bytes: Optional[bytes], answers: Dict[str, str]) -> Tuple[str, Optional[str]]:
    """One item applied; (log marker, postponement reason or None)."""
    kind = item["kind"]
    if kind == "update":
        back_up_file(root, set_dir, item["path"])
        entry["backups"] = [item["path"]]
        write_manifest(set_dir, manifest, E_PARTIAL)
        apply_update(root, mirror, item, from_bytes)
        return ("applied, merged" if from_bytes is not None else "applied"), None
    if kind == "new":
        apply_new(root, mirror, item)
        return "new", None
    if kind == "bin":
        apply_bin(root, mirror, set_dir, manifest, item, entry)
        return "applied", None
    if kind == "retired":
        reason = apply_retired(root, set_dir, manifest, item, entry)
        return ("retired, postponed" if reason else "retired"), reason
    return apply_register(root, set_dir, item, entry, answers), None


def run_apply(root: Path, plan: dict, selected: List[dict], from_path: Optional[Path],
              from_bytes: Optional[bytes], answers: Dict[str, str]) -> int:
    """The selected items, in order, against one backup set: each file
    backed up before it is touched, the manifest rewritten after each
    item, a log line per applied or postponed item. A failure stops the
    run (E_PARTIAL); a postponed listen unit doesn't, and the run exits
    POSTPONED when everything else applied. A value maestro-register-keys
    refuses (E_USAGE) leaves the item pending and propagates."""
    mirror = Path(plan["mirror"])
    upstream = plan["versions"].get("upstream")
    set_dir, manifest = open_set(root, plan, selected)
    print(f"SET {set_dir}")
    entries = {entry["id"]: entry for entry in manifest["items"]}
    applied = failed = postponed = 0
    for item in selected:
        entry = entries[item["id"]]
        try:
            marker, reason = apply_item(root, mirror, set_dir, manifest, item, entry, from_bytes, answers)
        except (OSError, UnicodeDecodeError, SyncError) as exc:
            if isinstance(exc, SyncError) and exc.code == E_USAGE:
                raise
            entry["outcome"] = "failed"
            entry["error"] = str(exc)
            write_manifest(set_dir, manifest, E_PARTIAL)
            print(f"maestro-sync: {item['id']} {item['path']} failed: {exc}", file=sys.stderr)
            print(f"failed   {item['id']:<4} {item['kind']:<8} {item['path']}")
            failed += 1
            break
        if reason:
            entry["outcome"] = "postponed"
            entry["reason"] = reason
            postponed += 1
            verdict = "postponed"
        else:
            entry["outcome"] = "applied"
            entry["applied_at"] = utc_now().isoformat()
            if from_path is not None:
                entry["from_file"] = str(from_path)
            applied += 1
            verdict = "applied"
        write_manifest(set_dir, manifest, E_PARTIAL)
        append_log(root, item_log_line(item, marker, upstream))
        print(f"{verdict:<8} {item['id']:<4} {item['kind']:<8} {item['path']}")
    pending = len(selected) - applied - failed - postponed
    print(f"RESULT applied={applied} failed={failed} postponed={postponed} pending={pending}")
    if failed:
        return E_PARTIAL
    return POSTPONED if postponed else OK


# --------------------------------------------------------------------------
# apply: retention of the sets
# --------------------------------------------------------------------------

def set_stamp_time(folder: Path) -> Optional[datetime]:
    """The UTC time a set's folder name carries; None for a folder that
    isn't `<stamp>-sync`."""
    m = SET_STAMP_RE.match(folder.name)
    if not m or not folder.is_dir():
        return None
    try:
        return datetime.strptime(m.group(1), STAMP_FORMAT).replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def prune_sets(root: Path, current: Path) -> List[Path]:
    """Retention by folder stamp: the RETENTION_KEEP newest sets stay; of
    the rest, a set older than RETENTION_MIN_AGE goes; when more than
    RETENTION_MAX remain, the oldest go too. The set of this run always
    stays. Returns the removed folders; a folder that can't be removed is a
    warning on stderr, never a failure."""
    stamped = []
    for folder in (root / BACKUPS_DIR).glob(f"*{SET_SUFFIX}"):
        when = set_stamp_time(folder)
        if when is not None:
            stamped.append((when, folder))
    stamped.sort(key=lambda pair: pair[0], reverse=True)
    now = utc_now()
    survivors = stamped[:RETENTION_KEEP]
    doomed: List[Path] = []
    for when, folder in stamped[RETENTION_KEEP:]:
        if folder != current and now - when > RETENTION_MIN_AGE:
            doomed.append(folder)
        else:
            survivors.append((when, folder))
    while len(survivors) > RETENTION_MAX:
        when, folder = survivors.pop()
        if folder == current:
            survivors.insert(0, (when, folder))
            continue
        doomed.append(folder)
    removed: List[Path] = []
    for folder in doomed:
        try:
            shutil.rmtree(folder)
        except OSError as exc:
            print(f"maestro-sync: warning: cannot remove the old set {folder}: {exc}", file=sys.stderr)
            continue
        removed.append(folder)
        print(f"PRUNED {folder}")
    return removed


def cmd_apply(args) -> int:
    ids = [i.strip() for i in (args.items or "").split(",") if i.strip()] if args.items else None
    if bool(ids) == bool(args.kind):
        raise SyncError(E_USAGE, "give either --items ID[,ID...] or --kind KIND")
    from_path = from_bytes = None
    if args.from_file:
        if args.kind or len(ids) != 1:
            raise SyncError(E_USAGE, "--from FILE goes with exactly one --items id, never with --kind")
        from_path = Path(args.from_file)
        try:
            from_bytes = from_path.read_bytes()
        except OSError as exc:
            raise SyncError(E_USAGE, f"cannot read --from {from_path}: {exc}")
    answers = parse_register_answers(args.register or [])
    if answers:
        validate_register_answers(answers)
    root = instance_root(args.instance or os.getcwd())
    plan = load_plan(root)
    lock = acquire_lock(root)
    try:
        selected = select_items(root, plan, ids, args.kind)
        if from_path is not None and selected and selected[0]["kind"] != "update":
            raise SyncError(E_USAGE, f"--from FILE applies to an update item, {selected[0]['id']} is "
                                     f"{selected[0]['kind']}")
        if answers and not any(it["kind"] == "register" for it in selected):
            raise SyncError(E_USAGE, "--register KEY=VALUE goes with a register item, and none is selected")
        check_fresh(root, plan, selected)
        if not selected:
            print("nothing to apply")
            return OK
        code = run_apply(root, plan, selected, from_path, from_bytes, answers)
        prune_sets(root, set_dir_for(root, plan))
        return code
    finally:
        release_lock(lock)


# --------------------------------------------------------------------------
# note
# --------------------------------------------------------------------------

def cmd_note(args) -> int:
    root = instance_root(args.instance or os.getcwd())
    plan = load_plan(root)
    if args.id is None and args.outcome != "aborted":
        raise SyncError(E_USAGE, f"an item id is required for --outcome {args.outcome}")
    if args.count is not None and args.outcome != "aborted":
        raise SyncError(E_USAGE, "--count goes with --outcome aborted")
    item = plan_item(plan, args.id) if args.id is not None else None
    upstream = plan["versions"].get("upstream")
    if args.outcome == "aborted":
        line = f"{log_stamp()}  ABORTED by owner after {args.count or 0} files"
    elif args.outcome == "skipped":
        line = item_log_line(item, "skipped by owner", upstream)
    else:
        if item["kind"] not in KEPT_KINDS:
            raise SyncError(E_USAGE, f"--outcome kept applies to {' or '.join(KEPT_KINDS)} items, "
                                     f"{item['id']} is {item['kind']}")
        line = item_log_line(item, f"{item['kind']}, kept by owner", upstream)
    append_log(root, line)
    print(line)
    return OK


def cmd_not_implemented(args) -> int:
    print(f"maestro-sync: `{args.verb}` is not implemented yet", file=sys.stderr)
    return E_USAGE


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    codes = "\n".join(f"  {code:>3}  {name:<15} {meaning}" for code, name, meaning in EXIT_CODES)
    p = argparse.ArgumentParser(
        prog="maestro-sync",
        description="Sync a Maestro instance with the template: the mechanics behind "
                    "/maestro:maestro-sync, without the conversation.",
        epilog="exit codes:\n" + codes,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="verb")

    sp = sub.add_parser("plan", help="Refresh the mirror, check the plugin and report the instance")
    sp.add_argument("--instance", help="instance root (default: the current directory)")
    sp.add_argument("--plugin-root",
                    help="root of the plugin this session loaded (CLAUDE_PLUGIN_ROOT); "
                         "without it the loaded-versus-installed check is skipped")
    sp.add_argument("--json", action="store_true", help="print the plan as JSON")
    sp.set_defaults(func=cmd_plan)

    sp = sub.add_parser("apply", help="Apply items of the last plan, after a backup set")
    sp.add_argument("--items", metavar="ID[,ID...]", help="the item ids to apply, in order")
    sp.add_argument("--kind", choices=APPLY_KINDS,
                    help="every item of this kind (update leaves out the locally modified ones)")
    sp.add_argument("--from", dest="from_file", metavar="FILE",
                    help="with one --items id of kind update: write this file's text as given")
    sp.add_argument("--register", action="append", metavar="KEY=VALUE",
                    help="with a register item: an answer for a missing key, by its dotted name "
                         "(tone_default.communication, communication.sign_off, ...); repeatable; "
                         "an unanswered key takes its default")
    sp.add_argument("--instance", help="instance root (default: the current directory)")
    sp.set_defaults(func=cmd_apply)

    sp = sub.add_parser("note", help="Record in the log an outcome the skill decided")
    sp.add_argument("id", nargs="?", help="the item (needed for skipped and kept)")
    sp.add_argument("--outcome", required=True, choices=NOTE_OUTCOMES)
    sp.add_argument("--count", type=int, metavar="N", help="with aborted: files applied before the stop")
    sp.add_argument("--instance", help="instance root (default: the current directory)")
    sp.set_defaults(func=cmd_note)

    for verb, text in (("rollback", "Restore a backup set"),
                       ("backups", "List the backup sets")):
        sp = sub.add_parser(verb, help=f"{text} (not implemented yet)")
        sp.add_argument("rest", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
        sp.set_defaults(func=cmd_not_implemented)
    return p


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.verb:
        parser.print_usage(sys.stderr)
        print("maestro-sync: a verb is required (plan, apply, note, rollback, backups)",
              file=sys.stderr)
        return E_USAGE
    try:
        return args.func(args)
    except SyncError as exc:
        print(f"maestro-sync: {exc}", file=sys.stderr)
        return exc.code


if __name__ == "__main__":
    sys.exit(main())
